<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DevFest Bacolod 2026 - Leaderboard</title>

    <!-- Browser tab icon -->
    <link rel="icon" type="image/png" href="/IMG/GDGTOP.png">

    <!-- Page stylesheet -->
    <link rel="stylesheet" href="/CSS/AdminLeaderboard.css">
    <link rel="stylesheet" href="/CSS/nav.css">
</head>

<body>

<%
    const currentTop1 = (typeof top1 !== 'undefined') ? top1 : null;
    const currentTop2 = (typeof top2 !== 'undefined') ? top2 : null;
    const currentTop3 = (typeof top3 !== 'undefined') ? top3 : null;
    const currentRanks4to7 = (typeof ranks4to7 !== 'undefined' && Array.isArray(ranks4to7)) ? ranks4to7 : [];
    const currentRanks8plus = (typeof ranks8to12 !== 'undefined' && Array.isArray(ranks8to12)) ? ranks8to12 : [];
    const currentEv = (typeof currentEvent !== 'undefined') ? currentEvent : null;
    const selectedEvId = (typeof selectedEventId !== 'undefined') ? selectedEventId : 1;
    const sessionSid = (typeof sid !== 'undefined' && sid) ? sid : '';
    const sidParam = sessionSid ? ('?sid=' + encodeURIComponent(sessionSid)) : '';

    // Truncate name if exceeding character limit and append '...'
    function truncateText(str, maxLen = 15) {
        if (!str) return '';
        const trimmed = String(str).trim();
        if (trimmed.length > maxLen) {
            return trimmed.substring(0, maxLen).trimEnd() + '...';
        }
        return trimmed;
    }
%>

<div class="page-shell">

    <!-- Shared navbar -->
    <%- include('partials/nav', { currentPage: 'adminleaderboard', isLoggedIn: true, isAdmin: (typeof isAdmin !== 'undefined' ? isAdmin : true) }) %>

    <!-- LEADERBOARD CONTENT -->
    <main class="leaderboard">

        <div class="ambient ambient-top"></div>
        <div class="ambient ambient-bottom"></div>

        <!-- TITLE -->
        <section class="page-heading">
            <h1>LEADERBOARD</h1>

            <div class="subtitle">
                <span></span>
                <p>TOP ATTENDEES PERFORMERS &middot; <%= (typeof trackName !== 'undefined' && trackName) ? trackName.toUpperCase() : 'EVENT STANDINGS' %></p>
                <span></span>
            </div>

            <!-- EVENT SELECTION DROPDOWN -->
            <% 
            const adminEventsList = (typeof allEvents !== 'undefined' && Array.isArray(allEvents) && allEvents.length > 0)
                ? allEvents
                : [
                    { id: 1, event_name: 'Student Dev Day' },
                    { id: 2, event_name: 'Professional Dev Day' }
                  ];
            const currentAdminEventName = (adminEventsList.find(e => parseInt(e.id, 10) === parseInt(selectedEvId, 10))?.event_name) || 'Select Event';
            %>
            <div class="leaderboard-event-dropdown-container">
                <div class="dropdown-menu-container leaderboard-event-custom-dropdown" id="adminLeaderboardDropdownContainer">
                    <button type="button" class="leaderboard-event-btn-trigger" id="adminLeaderboardEventBtn" aria-expanded="false" aria-haspopup="true">
                        <img src="/api/event-logo/<%= selectedEvId %>" alt="Event Logo" class="leaderboard-event-badge-logo" onerror="this.src='/IMG/test_green.png'">
                        <span class="dropdown-event-label">Event:</span>
                        <span class="dropdown-event-current-name"><%= currentAdminEventName %></span>
                        <svg class="dropdown-chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    <div class="dropdown-popover leaderboard-event-popover" id="adminLeaderboardEventPopover" role="menu">
                        <% adminEventsList.forEach(function(ev) { 
                            const isCurrent = (parseInt(selectedEvId, 10) === parseInt(ev.id, 10));
                        %>
                        <a href="/adminleaderboard?event_id=<%= ev.id %>"
                           class="dropdown-item leaderboard-event-item <%= isCurrent ? 'is-selected' : '' %>"
                           role="menuitem">
                            <img src="/api/event-logo/<%= ev.id %>" alt="<%= ev.event_name %>" class="leaderboard-item-event-logo" onerror="this.src='/IMG/test_green.png'">
                            <span class="leaderboard-item-event-text"><%= ev.event_name %></span>
                            <% if (isCurrent) { %>
                                <span class="leaderboard-item-check">✓</span>
                            <% } %>
                        </a>
                        <% }); %>
                    </div>

                    <!-- Hidden native select for backwards compatibility and accessibility -->
                    <select id="adminEventSelect" class="sr-only-select" aria-label="Select Event Leaderboard" onchange="if(this.value) window.location.href=this.value;">
                        <% adminEventsList.forEach(function(ev) { %>
                        <option value="/adminleaderboard?event_id=<%= ev.id %>"
                                <%= (parseInt(selectedEvId, 10) === parseInt(ev.id, 10)) ? 'selected' : '' %>>
                            <%= ev.event_name %>
                        </option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <!-- Optional locked event metadata for Leaderboard.js real-time live sync -->
            <div class="locked-event-banner" id="lockedEventBanner" data-event-id="<%= selectedEvId %>" style="display: none;"></div>
        </section>

        <!-- TOP THREE PODIUM -->
        <section class="podium" id="podiumSection">

            <!-- SECOND PLACE -->
            <article class="podium-card second-place">

                <div class="avatar">
                    <span class="avatar-head"></span>
                    <span class="avatar-body"></span>
                </div>

                <div class="podium-info">
                    <h2 id="top2Name" title="<%= (currentTop2 && (currentTop2.name || currentTop2.id)) ? (currentTop2.name || currentTop2.id) : '' %>"><%= (currentTop2 && (currentTop2.name || currentTop2.id)) ? truncateText(currentTop2.name || currentTop2.id, 15) : 'No Attendee' %></h2>
                    <span class="podium-subid" id="top2Subid" style="display: none;"><%= (currentTop2 && currentTop2.name && currentTop2.id) ? currentTop2.id : '' %></span>
                    <p class="rank-label">TOP 2</p>
                    <span class="points" id="top2Points"><%= currentTop2 ? currentTop2.points : 0 %> PTS</span>
                </div>

            </article>

            <!-- FIRST PLACE -->
            <article class="podium-card first-place">

                <div class="crown">👑</div>

                <div class="avatar avatar-first">
                    <span class="avatar-head"></span>
                    <span class="avatar-body"></span>
                </div>

                <div class="podium-info">
                    <h2 id="top1Name" title="<%= (currentTop1 && (currentTop1.name || currentTop1.id)) ? (currentTop1.name || currentTop1.id) : '' %>"><%= (currentTop1 && (currentTop1.name || currentTop1.id)) ? truncateText(currentTop1.name || currentTop1.id, 15) : 'No Attendee' %></h2>
                    <span class="podium-subid" id="top1Subid" style="display: none;"><%= (currentTop1 && currentTop1.name && currentTop1.id) ? currentTop1.id : '' %></span>
                    <p class="rank-label">TOP 1</p>
                    <span class="points" id="top1Points"><%= currentTop1 ? currentTop1.points : 0 %> PTS</span>
                </div>

            </article>

            <!-- THIRD PLACE -->
            <article class="podium-card third-place">

                <div class="avatar">
                    <span class="avatar-head"></span>
                    <span class="avatar-body"></span>
                </div>

                <div class="podium-info">
                    <h2 id="top3Name" title="<%= (currentTop3 && (currentTop3.name || currentTop3.id)) ? (currentTop3.name || currentTop3.id) : '' %>"><%= (currentTop3 && (currentTop3.name || currentTop3.id)) ? truncateText(currentTop3.name || currentTop3.id, 15) : 'No Attendee' %></h2>
                    <span class="podium-subid" id="top3Subid" style="display: none;"><%= (currentTop3 && currentTop3.name && currentTop3.id) ? currentTop3.id : '' %></span>
                    <p class="rank-label">TOP 3</p>
                    <span class="points" id="top3Points"><%= currentTop3 ? currentTop3.points : 0 %> PTS</span>
                </div>

            </article>

        </section>

        <!-- RANKINGS LIST (TOP 4 - 7) -->
        <section class="rank-list" id="rankListSection">

            <div id="ranks4to7List">
                <% if (currentRanks4to7 && currentRanks4to7.length > 0) { %>
                    <% currentRanks4to7.forEach((item) => { %>
                        <article class="rank-row" data-rank-id="<%= item.id %>">
                            <span class="rank-number"><%= item.rank %></span>
                            <strong title="<%= item.name || item.id %>"><%= truncateText(item.name || item.id, 15) %></strong>
                            <span class="row-points"><%= item.points %> PTS</span>
                        </article>
                    <% }); %>
                <% } %>
            </div>

            <!-- CONTINUATION (RANKS 8 - 12) HIDDEN BY DEFAULT -->
            <div class="more-rankings" id="moreRankings">
                <% if (currentRanks8plus && currentRanks8plus.length > 0) { %>
                    <% currentRanks8plus.forEach((item) => { %>
                        <article class="rank-row" data-rank-id="<%= item.id %>">
                            <span class="rank-number"><%= item.rank %></span>
                            <strong title="<%= item.name || item.id %>"><%= truncateText(item.name || item.id, 15) %></strong>
                            <span class="row-points"><%= item.points %> PTS</span>
                        </article>
                    <% }); %>
                <% } %>
            </div>

        </section>

        <!-- VIEW MORE / SHOW LESS BUTTON -->
        <button
            class="full-standings-btn"
            id="fullStandingsBtn"
            type="button"
            aria-expanded="false"
            aria-controls="moreRankings"
        >
            View More Rankings <span>↓</span>
        </button>

        <!-- FOOTER -->
        <footer>
            © 2026 GDG BACOLOD - AI Innovations Team. All Rights Reserved
        </footer>

    </main>

</div>

<script src="/JAVASCRIPT/Leaderboard.js" defer></script>
<script src="/JAVASCRIPT/nav.js" defer></script>
</body>
</html>
