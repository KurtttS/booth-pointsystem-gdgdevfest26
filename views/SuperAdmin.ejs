                                            No events found in the database.
                                        </div>
                                    <% } else { %>
                                        <% events.forEach(function(ev) { %>
                                            <div class="table-row-events-item" data-id="<%= ev.id %>">
                                                <span class="table-cell-id">#<%= ev.id %></span>
                                                <span style="font-weight: 800; color: #0d1b54; display: inline-flex; align-items: center; gap: 8px;">
                                                    <img src="/api/event-logo/<%= ev.id %>" class="event-table-logo" alt="" onerror="this.src='/IMG/test_green.png'">
                                                    <span><%= ev.event_name %></span>
                                                </span>
                                                <span><%= ev.venue || 'Bacolod City' %></span>
                                                <span><%= ev.event_date ? new Date(ev.event_date).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' }) : 'Nov 2026' %></span>
                                                <span><strong style="color: #0b6534;"><%= ev.attendeeCount || 0 %></strong> Registrations</span>
                                                <span><strong style="color: #1d4ed8;"><%= ev.scanCount || 0 %></strong> Scans</span>
                                                <div class="table-cell-actions">
                                                    <button class="btn-action-edit" type="button"
                                                            data-id="<%= ev.id %>"
                                                            data-name="<%= ev.event_name %>"
