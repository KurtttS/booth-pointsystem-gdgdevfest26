                                            </svg>
                                            <span><%= (typeof selectedEventId !== 'undefined' && selectedEventId) ? (eventDropdownList.find(e => e.id === selectedEventId)?.event_name || 'Event ' + selectedEventId) : 'Filter by Events' %></span>
