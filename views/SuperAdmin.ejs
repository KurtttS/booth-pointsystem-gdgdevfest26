<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DevFest Bacolod 2026 - SuperAdmin</title>

    <!-- Browser tab icon -->
    <link rel="icon" type="image/png" href="/IMG/GDGTOP.png?v=2">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/CSS/SuperAdmin.css">
    <link rel="stylesheet" href="/CSS/nav.css">
</head>

<body>
<%
    const safeLoggedIn = (typeof isLoggedIn !== 'undefined' && isLoggedIn);
    const safeAdmin = (typeof isAdmin !== 'undefined' && isAdmin);
    const safeActiveTab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'overview';
    const safeAttendees = (typeof attendees !== 'undefined' && Array.isArray(attendees)) ? attendees : [];
    const safeBooths = (typeof booths !== 'undefined' && Array.isArray(booths)) ? booths : [];
    const safeEvents = (typeof events !== 'undefined' && Array.isArray(events)) ? events : [];
    const safeSid = (typeof sid !== 'undefined' && sid) ? sid : '';
%>

    <div class="page <%= !safeLoggedIn ? 'page-login' : '' %>">
        <div class="site-shell">

            <!-- Shared navbar -->
            <%- include('partials/nav', {
                currentPage: 'SuperAdmin.php',
                activeTab: safeActiveTab,
                isLoggedIn: safeLoggedIn,
                isAdmin: safeAdmin,
                sid: safeSid
            }) %>

            <% if (!safeLoggedIn) { %>

                <!-- ==============================================================
                     SUPER ADMIN LOGIN SCREEN (When unauthenticated)
                     ============================================================== -->
                <main class="main-content">
                    <section class="login-card" aria-labelledby="pageTitle">

                        <div class="card-brand" aria-label="DevFest Bacolod 2026">
                            <img src="/IMG/GDG_LOGO.png" alt="DevFest Logo" class="gdg-logo">
                            <span class="brand-copy">
                                <span class="brand-name">DevFest</span>
                                <span class="brand-location">Bacolod 2026</span>
                            </span>
                        </div>

                        <h1 id="pageTitle" class="login-title">SuperAdmin Terminal</h1>
                        <p class="subtitle">LOGIN FOR DEVFEST ADMINISTRATORS</p>

                        <% if (typeof message !== 'undefined' && message) { %>
                            <div class="alert-banner <%= messageSuccess ? 'alert-success' : 'alert-error' %>" role="alert">
                                <span><%= message %></span>
                            </div>
                        <% } %>

                        <form id="adminLoginForm" action="/SuperAdmin.php" method="post">
                            <input type="hidden" name="sid" value="<%= (typeof sid !== 'undefined') ? sid : '' %>">

                            <div class="field">
                                <label for="adminUsername">Admin Username</label>
                                <div class="input-wrap">
                                    <span class="field-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <circle cx="12" cy="9" r="3.2"></circle>
                                            <path d="M5.5 19c.9-3 3.3-4.6 6.5-4.6s5.6 1.6 6.5 4.6"></path>
                                        </svg>
                                    </span>
                                    <input id="adminUsername" name="username" type="text" autocomplete="username" placeholder="Enter admin username" required autofocus>
                                </div>
                            </div>

                            <div class="field">
                                <label for="adminPassword">Admin Password</label>
                                <div class="input-wrap">
                                    <span class="field-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2ZM10 7a2 2 0 1 1 4 0v2h-4V7Zm2 9.8a1.8 1.8 0 1 1 1.8-1.8 1.8 1.8 0 0 1-1.8 1.8Z"></path>
                                        </svg>
                                    </span>
                                    <input id="adminPassword" name="password" type="password" autocomplete="current-password" placeholder="Enter admin password" required>
                                    <button class="toggle-password" type="button" id="toggleAdminPassword" aria-label="Show password">
                                        <svg id="adminEyeIcon" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M12 5c-5.2 0-9.4 4.5-10.5 6.1a1.5 1.5 0 0 0 0 1.8C2.6 14.5 6.8 19 12 19s9.4-4.5 10.5-6.1a1.5 1.5 0 0 0 0-1.8C21.4 9.5 17.2 5 12 5Zm0 11.2a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm0-2.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <button class="login-button" type="submit">LOGIN ADMIN</button>
                        </form>
                    </section>

                    <div class="superadmin-footer">
                        © 2026 GDG BACOLOD - AI Innovations Team . All Rights Reserved
                    </div>
                </main>

            <% } else { %>

                <!-- ==============================================================
                     AUTHENTICATED SUPER ADMIN PORTAL (Screenshots 1, 2, 3, 4)
                     ============================================================== -->
                <div class="superadmin-bg-mesh">
                    <div class="superadmin-container">

                        <!-- Notification Banner -->
                        <% if (typeof message !== 'undefined' && message) { %>
                            <div class="alert-banner <%= messageSuccess ? 'alert-success' : 'alert-error' %>" role="alert">
                                <span><%= message %></span>
                            </div>
                        <% } %>

                        <% if (activeTab === 'overview') { %>

                            <!-- ==============================================================
                                 SCREENSHOT 1: OVERVIEW PAGE
                                 ============================================================== -->
                            <div class="superadmin-header">
                                <h1 class="superadmin-title">Welcome, Super Admin <%= displayName %>!</h1>
                                <p class="superadmin-subtitle">DevFest Bacolod 2026 - Google Developer Groups</p>
                            </div>

                            <div class="overview-grid">
                                <!-- Left Column: Attendees Bar Chart + Booths Donut Chart -->
                                <div class="overview-left-col">

                                    <!-- Card 1: Attendees -->
                                    <div class="superadmin-card">
                                        <h2 class="card-heading">Attendees</h2>
                                        <p class="card-subheading">Number of attendees per booth.</p>

                                        <!-- Bar Chart Container -->
                                        <%
                                            const maxCount = Math.max(10, ...(attendeesPerBooth || []).map(b => b.count));
                                            // Scale Y-axis ticks to nice round numbers
                                            const yMax = Math.max(100, Math.ceil(maxCount / 100) * 100);
                                            const yStep = Math.round(yMax / 7);
                                        %>
                                        <div class="bar-chart-container">
                                            <div class="chart-y-axis">
                                                <span><%= yMax %>+</span>
                                                <span><%= Math.round(yStep * 6) %></span>
                                                <span><%= Math.round(yStep * 5) %></span>
                                                <span><%= Math.round(yStep * 4) %></span>
                                                <span><%= Math.round(yStep * 3) %></span>
                                                <span><%= Math.round(yStep * 2) %></span>
                                                <span><%= Math.round(yStep * 1) %></span>
                                                <span>0</span>
                                            </div>

                                            <div class="chart-bars-wrap">
                                                <% (attendeesPerBooth || []).slice(0, 8).forEach(function(booth) {
                                                    const barHeightPct = Math.min(100, Math.max(3, Math.round((booth.count / yMax) * 100)));
                                                %>
                                                    <div class="chart-bar-group" title="<%= booth.name %>: <%= booth.count %> attendees">
                                                        <div class="chart-bar-tooltip"><%= booth.name %>: <%= booth.count %></div>
                                                        <div class="chart-bar" style="height: <%= barHeightPct %>%;"></div>
                                                        <div class="chart-bar-label"><%= booth.name %></div>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card 2: Booths (Donut Chart) -->
                                    <div class="superadmin-card">
                                        <h2 class="card-heading">Booths</h2>
                                        <p class="card-subheading">Outstanding Booths with most rewarded points.</p>

                                        <div class="donut-chart-wrap">
                                            <%
                                                const topBooths = (boothsRewardedPoints || []).slice(0, 4);
                                                const totalDonutPoints = topBooths.reduce((sum, b) => sum + (b.points || 0), 0) || 1;
                                                const donutColors = ['#0d1b54', '#1e7e34', '#fbc02d', '#d32f2f'];
                                                const radius = 60;
                                                const circumference = 2 * Math.PI * radius; // ~376.99
                                                let accumulatedOffset = 0;
                                            %>
                                            <svg class="donut-svg" viewBox="0 0 170 170">
                                                <% if (topBooths.length === 0) { %>
                                                    <circle cx="85" cy="85" r="<%= radius %>" class="donut-segment" stroke="#e2e8f0" stroke-dasharray="<%= circumference %>" stroke-dashoffset="0"></circle>
                                                <% } else { %>
                                                    <% topBooths.forEach(function(b, idx) {
                                                        const pct = (b.points / totalDonutPoints);
                                                        const segLength = pct * circumference;
                                                        const color = donutColors[idx % donutColors.length];
                                                        const currentOffset = accumulatedOffset;
                                                        accumulatedOffset += segLength;
                                                    %>
                                                        <circle cx="85" cy="85" r="<%= radius %>" class="donut-segment" stroke="<%= color %>"
                                                                stroke-dasharray="<%= segLength %> <%= circumference - segLength %>"
                                                                stroke-dashoffset="-<%= currentOffset %>">
                                                            <title><%= b.name %>: <%= b.points.toLocaleString() %> pts (<%= Math.round(pct * 100) %>%)</title>
                                                        </circle>
                                                    <% }); %>
                                                <% } %>
                                            </svg>

                                            <!-- Legend -->
                                            <div class="donut-legend">
                                                <% if (topBooths.length === 0) { %>
                                                    <div class="donut-legend-item">
                                                        <span class="legend-dot" style="background: #94a3b8;"></span>
                                                        <span>No scan points recorded yet</span>
                                                    </div>
                                                <% } else { %>
                                                    <% topBooths.forEach(function(b, idx) { %>
                                                        <div class="donut-legend-item">
                                                            <span class="legend-dot" style="background: <%= donutColors[idx % donutColors.length] %>;"></span>
                                                            <span><%= b.name %></span>
                                                        </div>
                                                    <% }); %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Right Column: Most Recent Scans -->
                                <div class="superadmin-card overview-right-card">
                                    <h2 class="card-heading">Most Recent Scans</h2>
                                    <p class="card-subheading">Live activity and points awarded across event booths.</p>

                                    <div class="attendees-card-header">
                                        <h3 class="attendees-header-title">Live Activity Feed</h3>

                                        <div class="dropdown-menu-container">
                                            <button class="event-filter-btn" type="button" id="overviewFilterToggle">
                                                <span>Filter by Events</span>
                                                <svg viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"></path>
                                                </svg>
                                            </button>

                                            <div class="dropdown-popover" id="overviewFilterPopover">
                                                <a href="/SuperAdmin.php?tab=overview<%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>"
                                                   class="dropdown-item <%= !selectedEventId ? 'is-selected' : '' %>">All Events</a>
                                                <% safeEvents.forEach(function(ev) { %>
                                                    <a href="/SuperAdmin.php?tab=overview&event_id=<%= ev.id %><%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>"
                                                       class="dropdown-item <%= selectedEventId === ev.id ? 'is-selected' : '' %>">
                                                        <img src="/api/event-logo/<%= ev.id %>" alt="" class="dropdown-item-logo" onerror="this.src='/IMG/test_green.png'">
                                                        <span><%= ev.event_name %></span>
                                                    </a>
                                                <% }); %>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="attendees-list recent-scans-feed" style="max-height: 480px; overflow-y: auto;">
                                        <% const scanFeed = (typeof recentScans !== 'undefined' && recentScans && recentScans.length > 0) ? recentScans : (attendeesInformation || []); %>
                                        <% if (!scanFeed || scanFeed.length === 0) { %>
                                            <div style="text-align: center; color: #94a3b8; padding: 40px 10px; font-weight: 600;">
                                                No recent scans recorded for this event selection.
                                            </div>
                                        <% } else { %>
                                            <% scanFeed.forEach(function(scan, index) { %>
                                                <div class="scan-feed-item">
                                                    <div class="scan-feed-left">
                                                        <div class="scan-user-main">
                                                            <strong class="scan-user-name"><%= scan.attendeeName || scan.name || 'Attendee' %></strong>
                                                            <span class="scan-qr-badge"><%= scan.qrCodeToken || scan.id %></span>
                                                        </div>
                                                        <div class="scan-booth-meta">
                                                            <span class="scan-station-tag">📍 <%= scan.boothName || scan.boothId || 'Station' %></span>
                                                            <span class="scan-event-tag"><%= scan.eventName || 'DevFest Day' %></span>
                                                        </div>
                                                    </div>
                                                    <div class="scan-feed-right">
                                                        <span class="scan-points-badge">+<%= scan.points || 0 %> PTS</span>
                                                        <span class="scan-time-ago"><%= scan.timeAgo || scan.timeFormatted || 'Just now' %></span>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
                                </div>
                            </div>


                        <% } else if (activeTab === 'attendees') { %>

                            <!-- ==============================================================
                                 SCREENSHOT 2: ATTENDEES PAGE
                                 ============================================================== -->
                            <div class="superadmin-action-bar">
                                <div class="action-bar-left">
                                    <!-- Search input -->
                                    <div class="search-pill-wrap">
                                        <svg class="search-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <circle cx="11" cy="11" r="7"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg>
                                        <input type="text" id="attendeeSearchInput" placeholder="Search Attendee" value="<%= (typeof searchQuery !== 'undefined') ? searchQuery : '' %>">
                                    </div>

                                    <!-- Funnel filter -->
                                    <div class="dropdown-menu-container">
                                        <button class="event-filter-btn" type="button" id="attendeesFilterToggle" title="Filter by Event">
                                            <svg viewBox="0 0 24 24" fill="currentColor" style="width: 15px; height: 15px; color: #d97706;">
                                                <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"></path>
                                            </svg>
                                            <span><%= (typeof selectedEventId !== 'undefined' && selectedEventId) ? (safeEvents.find(e => e.id === selectedEventId)?.event_name || 'Event ' + selectedEventId) : 'Filter by Event' %></span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px;">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </button>
                                        <div class="dropdown-popover" id="attendeesFilterPopover">
                                            <a href="/SuperAdmin.php?tab=attendees<%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>"
                                               class="dropdown-item <%= !selectedEventId ? 'is-selected' : '' %>">All Events</a>
                                            <% safeEvents.forEach(function(ev) { %>
                                                <a href="/SuperAdmin.php?tab=attendees&event_id=<%= ev.id %><%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>"
                                                   class="dropdown-item <%= selectedEventId === ev.id ? 'is-selected' : '' %>">
                                                    <img src="/api/event-logo/<%= ev.id %>" alt="" class="dropdown-item-logo" onerror="this.src='/IMG/test_green.png'">
                                                    <span><%= ev.event_name %></span>
                                                </a>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>

                                <button class="btn-pill-add btn-pill-add-gold" type="button" id="openAddAttendeeModal">
                                    Add Attendee +
                                </button>
                            </div>

                            <!-- Attendees Table -->
                            <div class="superadmin-table-card">
                                <div class="table-header-gold">
                                    <span>QR Code</span>
                                    <span>Attendee Name</span>
                                    <span>Email</span>
                                    <span>Event Attended</span>
                                    <span>Actions</span>
                                </div>

                                <div id="attendeesTableBody">
                                    <% if (!attendees || attendees.length === 0) { %>
                                        <div style="padding: 40px; text-align: center; color: #64748b; font-weight: 600;">
                                            No attendee records found matching your filters.
                                        </div>
                                    <% } else { %>
                                        <% attendees.forEach(function(att, idx) { %>
                                            <div class="table-row-item table-row-attendee" data-id="<%= att.id %>" data-index="<%= idx %>" data-search="<%= ((att.qrId || '') + ' ' + (att.fullName || '') + ' ' + (att.email || '') + ' ' + (att.eventName || '')).toLowerCase() %>">
                                                <span class="table-cell-id"><%= att.qrId %></span>
                                                <span><%= att.fullName %></span>
                                                <span style="font-size: 13px; font-weight: 600; color: #334155; word-break: break-all;"><%= att.email %></span>
                                                <span><%= att.eventName %></span>
                                                <div class="table-cell-actions">
                                                    <button class="btn-action-edit" type="button"
                                                            data-id="<%= att.id %>"
                                                            data-qrid="<%= att.qrId %>"
                                                            data-firstname="<%= att.firstName %>"
                                                            data-lastname="<%= att.lastName %>"
                                                            data-email="<%= att.email %>"
                                                            data-address="<%= att.address %>"
                                                            data-eventid="<%= att.eventId %>"
                                                            onclick="openEditAttendee(this)"
                                                            title="Edit Attendee">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M12 20h9"></path>
                                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                        </svg>
                                                    </button>
                                                    <button class="btn-action-delete" type="button"
                                                            data-id="<%= att.id %>"
                                                            data-name="<%= att.fullName %>"
                                                            onclick="openDeleteAttendee(this)">
                                                        Delete
                                                    </button>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>

                                <!-- Pagination Bar (Matches Reference Layout) -->
                                <div class="table-pagination-bar" id="attendeesPaginationBar">
                                    <div class="pagination-top-row">
                                        <div class="pagination-nav-group">
                                            <button type="button" class="btn-page-nav" id="pagPrevBtn" aria-label="Previous Page">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="15 18 9 12 15 6"></polyline>
                                                </svg>
                                            </button>
                                            <div class="pagination-pages" id="pagPageNumbers"></div>
                                            <button type="button" class="btn-page-nav" id="pagNextBtn" aria-label="Next Page">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="9 18 15 12 9 6"></polyline>
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="pagination-bottom-row">
                                        <div class="pagination-size-wrap">
                                            <select class="pagination-size-select" id="attendeesPageSizeSelect" aria-label="Items per page">
                                                <option value="10" selected>10</option>
                                                <option value="25">25</option>
                                                <option value="50">50</option>
                                                <option value="100">100</option>
                                            </select>
                                        </div>
                                        <div class="pagination-results-text">
                                            Results: <span id="pagStart">1</span> - <span id="pagEnd">10</span> of <span id="pagTotal"><%= attendees ? attendees.length : 0 %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <% } else if (activeTab === 'booths') { %>

                            <% if (selectedBoothId === 'all') { %>

                                <!-- ==============================================================
                                     SCREENSHOT 3: ALL BOOTHS LIST PAGE
                                     ============================================================== -->
                                <div class="superadmin-action-bar">
                                    <div class="action-bar-left">
                                        <!-- Real-time search for booths -->
                                        <div class="search-pill-wrap">
                                            <svg class="search-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                                <circle cx="11" cy="11" r="7"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                            <input type="text" id="boothSearchInput" placeholder="Search Booth (name, username, location)..." value="<%= (typeof boothSearch !== 'undefined') ? boothSearch : '' %>">
                                        </div>

                                        <!-- Filter by Booth Type Dropdown -->
                                        <div class="dropdown-menu-container">
                                            <button class="event-filter-btn" type="button" id="boothsTypeFilterToggle">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px;">
                                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                                </svg>
                                                <span id="boothTypeFilterLabel">Type: <%= (typeof boothFilterType !== 'undefined' && boothFilterType !== 'all') ? boothFilterType.toUpperCase() : 'All Types' %></span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px;">
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                            </button>
                                            <div class="dropdown-popover" id="boothsTypeFilterPopover">
                                                <button type="button" data-type="all" data-label="All Types"
                                                        class="dropdown-item booth-filter-opt <%= (!boothFilterType || boothFilterType === 'all') ? 'is-selected' : '' %>">All Types</button>
                                                <button type="button" data-type="standard" data-label="Standard"
                                                        class="dropdown-item booth-filter-opt <%= boothFilterType === 'standard' ? 'is-selected' : '' %>">Standard Booths</button>
                                                <button type="button" data-type="sponsor" data-label="Sponsor"
                                                        class="dropdown-item booth-filter-opt <%= boothFilterType === 'sponsor' ? 'is-selected' : '' %>">Sponsor Booths</button>
                                                <button type="button" data-type="gdg" data-label="GDG"
                                                        class="dropdown-item booth-filter-opt <%= boothFilterType === 'gdg' ? 'is-selected' : '' %>">GDG Official Booths</button>
                                            </div>
                                        </div>

                                        <!-- Sort By Selector Custom Dropdown -->
                                        <div class="dropdown-menu-container">
                                            <button class="event-filter-btn" type="button" id="boothSortToggle" title="Sort Booths">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px;">
                                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                                </svg>
                                                <span id="boothSortLabel">Sort: <%= (typeof boothSortBy !== 'undefined' && boothSortBy === 'name_desc') ? 'Name Z-A' : (typeof boothSortBy !== 'undefined' && boothSortBy === 'date_desc') ? 'Date: Newest to Oldest' : (typeof boothSortBy !== 'undefined' && boothSortBy === 'date_asc') ? 'Date: Oldest to Newest' : 'Name A-Z' %></span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px;">
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                            </button>
                                            <div class="dropdown-popover" id="boothSortPopover">
                                                <button type="button" data-sort="name_asc" data-label="Sort: Name A-Z"
                                                        class="dropdown-item booth-sort-opt <%= (!boothSortBy || boothSortBy === 'name_asc') ? 'is-selected' : '' %>">Name A-Z</button>
                                                <button type="button" data-sort="name_desc" data-label="Sort: Name Z-A"
                                                        class="dropdown-item booth-sort-opt <%= boothSortBy === 'name_desc' ? 'is-selected' : '' %>">Name Z-A</button>
                                                <button type="button" data-sort="date_desc" data-label="Sort: Newest to Oldest"
                                                        class="dropdown-item booth-sort-opt <%= boothSortBy === 'date_desc' ? 'is-selected' : '' %>">Date: Newest to Oldest</button>
                                                <button type="button" data-sort="date_asc" data-label="Sort: Oldest to Newest"
                                                        class="dropdown-item booth-sort-opt <%= boothSortBy === 'date_asc' ? 'is-selected' : '' %>">Date: Oldest to Newest</button>
                                            </div>
                                            <input type="hidden" id="boothSortSelect" value="<%= (typeof boothSortBy !== 'undefined' && boothSortBy) ? boothSortBy : 'name_asc' %>">
                                        </div>
                                    </div>

                                    <button class="btn-pill-add btn-pill-add-navy" type="button" id="openAddBoothModal">
                                        Add Booth +
                                    </button>
                                </div>

                                <!-- Booths Table -->
                                <div class="superadmin-table-card">
                                    <div class="table-header-navy">
                                        <span>Username</span>
                                        <span>Booth Name</span>
                                        <span>Booth Type</span>
                                        <span>Location</span>
                                        <span>Sponsor Name</span>
                                        <span>Actions</span>
                                    </div>

                                    <div id="boothsTableBody">
                                        <% if (!booths || booths.length === 0) { %>
                                            <div style="padding: 40px; text-align: center; color: #64748b; font-weight: 600;">
                                                No booths registered in the database.
                                            </div>
                                        <% } else { %>
                                            <% booths.forEach(function(b) { %>
                                                <div class="table-row-item table-row-booth table-row-clickable"
                                                     data-id="<%= b.id %>"
                                                     data-name="<%= (b.name || '').toLowerCase() %>"
                                                     data-username="<%= (b.loginUsername || b.id || '').toLowerCase() %>"
                                                     data-type="<%= (b.booth_type || 'standard').toLowerCase() %>"
                                                     data-location="<%= (b.location || '').toLowerCase() %>"
                                                     data-sponsor="<%= (b.sponsorName || b.sponsor || '').toLowerCase() %>"
                                                     data-scans="<%= b.scanCount || 0 %>"
                                                     data-date="<%= b.createdAt || b.created_at || '' %>"
                                                     data-search="<%= ((b.loginUsername || b.id || '') + ' ' + (b.name || '') + ' ' + (b.booth_type || '') + ' ' + (b.location || '') + ' ' + (b.sponsorName || b.sponsor || '')).toLowerCase() %>"
                                                     onclick="if (!event.target.closest('.table-cell-actions')) window.location.href='/SuperAdmin.php?tab=booths&booth_id=<%= encodeURIComponent(b.id) %><%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>'"
                                                     title="Click to view booth details and visitor scans">
                                                    <span class="table-cell-id">
                                                        <strong style="color: #0d1b54; font-size: 14px; font-weight: 800;"><%= b.loginUsername || b.id %></strong>
                                                    </span>
                                                    <span><strong><%= b.name %></strong></span>
                                                    <span>
                                                        <% const bType = (b.booth_type || b.boothType || 'standard').toLowerCase(); %>
                                                        <% if (bType === 'sponsor') { %>
                                                            <span style="display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 11.5px; font-weight: 750; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; text-transform: capitalize;">Sponsor</span>
                                                        <% } else if (bType === 'gdg') { %>
                                                            <span style="display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 11.5px; font-weight: 750; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; text-transform: uppercase;">GDG</span>
                                                        <% } else { %>
                                                            <span style="display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 11.5px; font-weight: 750; background: #f8fafc; color: #475569; border: 1px solid #e2e8f0; text-transform: capitalize;">Standard</span>
                                                        <% } %>
                                                    </span>
                                                    <span><%= b.location || 'Activity Area' %></span>
                                                    <span><%= b.sponsorName || b.sponsor || b.name %></span>
                                                    <div class="table-cell-actions">
                                                        <button class="btn-action-edit" type="button"
                                                                data-id="<%= b.id %>"
                                                                data-username="<%= b.loginUsername || b.id %>"
                                                                data-name="<%= b.name %>"
                                                                data-location="<%= b.location %>"
                                                                data-desc="<%= b.description %>"
                                                                data-sponsor="<%= b.sponsorName || b.sponsor %>"
                                                                data-type="<%= b.booth_type || 'standard' %>"
                                                                onclick="openEditBooth(this); event.stopPropagation();"
                                                                title="Edit Booth">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M12 20h9"></path>
                                                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                            </svg>
                                                        </button>
                                                        <button class="btn-action-delete" type="button"
                                                                data-id="<%= b.id %>"
                                                                data-name="<%= b.name %>"
                                                                onclick="openDeleteBooth(this); event.stopPropagation();">
                                                            Delete
                                                        </button>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
                                </div>

                            <% } else { %>

                                <!-- ==============================================================
                                     SCREENSHOT 4: BOOTH DETAIL / ANALYTICS VIEW
                                     ============================================================== -->
                                <div class="superadmin-action-bar">
                                    <div class="action-bar-left">
                                        <!-- Selected booth dropdown pill -->
                                        <div class="dropdown-menu-container">
                                            <button class="event-filter-btn" type="button" id="boothDetailDropdownToggle">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px;">
                                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                                </svg>
                                                <span><%= currentBooth ? currentBooth.name : 'Select Booth' %></span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px;">
                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                </svg>
                                            </button>
                                            <div class="dropdown-popover" id="boothDetailDropdownPopover">
                                                <a href="/SuperAdmin.php?tab=booths&booth_id=all<%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>"
                                                   class="dropdown-item">All Booths</a>
                                                <% safeBooths.forEach(function(b) { %>
                                                    <a href="/SuperAdmin.php?tab=booths&booth_id=<%= b.id %><%= sid ? '&sid=' + encodeURIComponent(sid) : '' %>"
                                                       class="dropdown-item <%= (currentBooth && currentBooth.id === b.id) ? 'is-selected' : '' %>"><%= b.name %></a>
                                                <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="booth-analytics-grid">
                                    <!-- Column 1 (Left): Visitors Table -->
                                    <div class="analytics-visitors-card">
                                        <div class="visitors-card-header">
                                            <span>QR Code Token</span>
                                            <span>Username</span>
                                        </div>

                                        <div class="visitors-list-wrap">
                                            <% if (!visitors || visitors.length === 0) { %>
                                                <div style="padding: 30px 20px; text-align: center; color: #94a3b8; font-weight: 600; font-size: 13px;">
                                                    No visitor scans recorded for this booth yet.
                                                </div>
                                            <% } else { %>
                                                <% visitors.forEach(function(v) { %>
                                                    <div class="visitor-row-item">
                                                        <span class="table-cell-id"><%= v.userId %></span>
                                                        <span><%= v.username %></span>
                                                    </div>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Column 2 (Middle): 3 Stat Cards -->
                                    <div class="analytics-middle-col">
                                        <!-- Stat 1: Total Unique Visitor -->
                                        <div class="stat-box-card">
                                            <div class="stat-icon-wrap">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 3s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                                                </svg>
                                            </div>
                                            <h3 class="stat-box-title">Total Unique Visitor</h3>
                                            <p class="stat-box-subtitle">Cumulative unique scans</p>
                                            <div class="stat-box-number-gold"><%= totalUniqueVisitors || 0 %></div>
                                            <div class="stat-box-unit">Attendees</div>
                                        </div>

                                        <!-- Stat 2: Current Reward Rate -->
                                        <div class="stat-box-card">
                                            <div class="stat-icon-wrap">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                                </svg>
                                            </div>
                                            <h3 class="stat-box-title">Current Reward Rate</h3>
                                            <p class="stat-box-subtitle">
                                                <%= (rewardTier && rewardTier.label) ? rewardTier.label : 'Early Bird' %>
                                            </p>
                                            <div class="stat-box-number-gold">+<%= (rewardTier && rewardTier.points) ? rewardTier.points : 100 %></div>
                                            <div class="stat-box-unit">Points</div>
                                        </div>

                                        <!-- Stat 3: Points Distributed -->
                                        <div class="stat-box-card">
                                            <div class="stat-icon-wrap">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="M19 3H5L2 9l10 12L22 9l-3-6zM12 17.5L5.5 9h13L12 17.5zM6.4 5h11.2l1.5 3H4.9l1.5-3z"/>
                                                </svg>
                                            </div>
                                            <h3 class="stat-box-title">Points Distributed</h3>
                                            <p class="stat-box-subtitle">Across <%= totalScans || 0 %> verified scans</p>
                                            <div class="stat-box-number-gold"><%= (pointsDistributed || 0).toLocaleString() %></div>
                                            <div class="stat-box-unit">Points</div>
                                        </div>
                                    </div>

                                    <!-- Column 3 (Right): 2 Big Stat Cards -->
                                    <div class="analytics-right-col">
                                        <!-- Big Stat 1: Total Scans -->
                                        <div class="big-stat-card">
                                            <div class="big-stat-icon">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="M4 4h6V2H4C2.9 2 2 2.9 2 4v6h2V4zm16 0h-6V2h6c1.1 0 2 .9 2 2v6h-2V4zM4 20h6v2H4c-1.1 0-2-.9-2-2v-6h2v6zm16 0h-6v2h6c1.1 0 2-.9 2-2v-6h-2v6zM12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 6c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
                                                </svg>
                                            </div>
                                            <h3 class="big-stat-title">Total Scans</h3>
                                            <div class="big-stat-number"><%= totalScans || 0 %></div>
                                            <div class="big-stat-badge-green">+<%= scansToday || 0 %> Scans Today</div>
                                        </div>

                                        <!-- Big Stat 2: Points Awarded -->
                                        <div class="big-stat-card">
                                            <div class="big-stat-icon big-stat-icon-blue">
                                                <svg viewBox="0 0 24 24">
                                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14.88V19h-2v-2.12c-1.72-.4-3-1.88-3-3.88h2c0 1.1.9 2 2 2s2-.9 2-2c0-.98-.65-1.54-1.92-2-1.73-.62-3.08-1.57-3.08-3.5 0-1.72 1.13-3.14 2.7-3.62V4h2v1.88c1.54.38 2.68 1.74 2.78 3.32h-2c-.1-.7-.65-1.2-1.48-1.2-.83 0-1.3.47-1.3 1.1 0 .8.62 1.25 1.83 1.68 1.83.65 3.17 1.62 3.17 3.72 0 1.78-1.18 3.25-2.7 3.7z"/>
                                                </svg>
                                            </div>
                                            <h3 class="big-stat-title">Points Awarded</h3>
                                            <div class="big-stat-number">+<%= (pointsAwarded || 0).toLocaleString() %></div>
                                            <p class="big-stat-description">Total points earned from successful QR scans and booth activities.</p>
                                        </div>
                                    </div>
                                </div>

                            <% } %>

                        <% } else if (activeTab === 'points') { %>

                            <!-- ==============================================================
                                 POINTS MANAGEMENT TAB (CRUD, Search, Filter, Display Attendee)
                                 ============================================================== -->
                            <!-- Summary Metrics Cards -->
                            <div class="points-stats-row">
                                <div class="point-stat-card">
                                    <div class="point-stat-title">Total Points Distributed</div>
                                    <div class="point-stat-number" style="color: #0b6534;"><%= (typeof totalPointsDistributed !== 'undefined' ? totalPointsDistributed : 0).toLocaleString() %></div>
                                    <div class="point-stat-subtext">Across all event checkpoints</div>
                                </div>
                                <div class="point-stat-card">
                                    <div class="point-stat-title">Total Verified Scans</div>
                                    <div class="point-stat-number"><%= (typeof totalScansCount !== 'undefined' ? totalScansCount : 0).toLocaleString() %></div>
                                    <div class="point-stat-subtext">Cumulative QR scan logs</div>
                                </div>
                                <div class="point-stat-card">
                                    <div class="point-stat-title">Average Points / Scan</div>
                                    <div class="point-stat-number" style="color: #1d4ed8;"><%= typeof avgPoints !== 'undefined' ? avgPoints : 0 %></div>
                                    <div class="point-stat-subtext">PTS per booth completion</div>
                                </div>
                                <div class="point-stat-card">
                                    <div class="point-stat-title">Attendees With Points</div>
                                    <div class="point-stat-number" style="color: #b45309;"><%= typeof uniqueAttendeesCount !== 'undefined' ? uniqueAttendeesCount : 0 %></div>
                                    <div class="point-stat-subtext">Active leaderboard participants</div>
                                </div>
                            </div>

                            <!-- Action Bar with Search, Event Filter, Booth Filter, and Award Points Button -->
                            <div class="superadmin-action-bar">
                                <div class="action-bar-left">
                                    <!-- Search input -->
                                    <div class="search-pill-wrap">
                                        <svg class="search-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <circle cx="11" cy="11" r="7"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                        </svg>
                                        <input type="text" id="pointsSearchInput" placeholder="Search Points (Attendee, QR, Booth, Event)..." value="<%= (typeof searchQuery !== 'undefined') ? searchQuery : '' %>">
                                    </div>

                                    <!-- Filter by Event Dropdown -->
                                    <div class="dropdown-menu-container">
                                        <button class="event-filter-btn" type="button" id="pointsEventFilterToggle">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px;">
                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                            </svg>
                                            <span id="pointsEventFilterLabel">Event: <%= (typeof selectedEventId !== 'undefined' && selectedEventId) ? (safeEvents.find(e => e.id === selectedEventId)?.event_name || 'Event ' + selectedEventId) : 'All Events' %></span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px;">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </button>
                                        <div class="dropdown-popover" id="pointsEventFilterPopover">
                                            <button type="button" data-eventid="all" data-label="All Events"
                                                    class="dropdown-item points-event-filter-opt <%= (!selectedEventId) ? 'is-selected' : '' %>">All Events</button>
                                            <% safeEvents.forEach(function(ev) { %>
                                                <button type="button" data-eventid="<%= ev.id %>" data-label="<%= ev.event_name %>"
                                                        class="dropdown-item points-event-filter-opt <%= (selectedEventId === ev.id) ? 'is-selected' : '' %>">
                                                    <img src="/api/event-logo/<%= ev.id %>" alt="" class="dropdown-item-logo" onerror="this.src='/IMG/test_green.png'">
                                                    <%= ev.event_name %>
                                                </button>
                                            <% }); %>
                                        </div>
                                    </div>

                                    <!-- Filter by Booth Dropdown -->
                                    <div class="dropdown-menu-container">
                                        <button class="event-filter-btn" type="button" id="pointsBoothFilterToggle">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px;">
                                                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                            </svg>
                                            <span id="pointsBoothFilterLabel">Booth: <%= (typeof selectedBoothId !== 'undefined' && selectedBoothId && selectedBoothId !== 'all') ? (safeBooths.find(b => b.id === selectedBoothId)?.name || selectedBoothId) : 'All Booths' %></span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px;">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </button>
                                        <div class="dropdown-popover" id="pointsBoothFilterPopover">
                                            <button type="button" data-boothid="all" data-label="All Booths"
                                                    class="dropdown-item points-booth-filter-opt <%= (!selectedBoothId || selectedBoothId === 'all') ? 'is-selected' : '' %>">All Booths</button>
                                            <% safeBooths.forEach(function(b) { %>
                                                <button type="button" data-boothid="<%= b.id %>" data-label="<%= b.name %>"
                                                        class="dropdown-item points-booth-filter-opt <%= (selectedBoothId === b.id) ? 'is-selected' : '' %>"><%= b.name %></button>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>

                                <button class="btn-pill-add" style="background: #0b6534; color: #ffffff;" type="button" id="openAddPointsModal">
                                    Award Points +
                                </button>
                            </div>

                            <!-- Points Table Card -->
                            <div class="superadmin-table-card">
                                <div class="table-header-green">
                                    <span>Attendee</span>
                                    <span>Station / Booth</span>
                                    <span>Event</span>
                                    <span>Points Value</span>
                                    <span>Date & Time</span>
                                    <span>Actions</span>
                                </div>

                                <div id="pointsTableBody">
                                    <% if (!pointsList || pointsList.length === 0) { %>
                                        <div style="padding: 40px; text-align: center; color: #64748b; font-weight: 600;">
                                            No points records found matching your filters.
                                        </div>
                                    <% } else { %>
                                        <% pointsList.forEach(function(p, idx) { %>
                                            <div class="table-row-points-item"
                                                 data-id="<%= p.id %>"
                                                 data-eventid="<%= p.eventId %>"
                                                 data-boothid="<%= (p.boothId || '').toString().toLowerCase() %>"
                                                 data-search="<%= ((p.attendeeName || '') + ' ' + (p.qrCodeToken || '') + ' ' + (p.attendeeEmail || '') + ' ' + (p.boothName || '') + ' ' + (p.eventName || '')).toLowerCase() %>">
                                                <!-- Attendee Information (display kay sino na ang points) -->
                                                <div>
                                                    <div style="font-weight: 800; color: #0d1b54; font-size: 14px;"><%= p.attendeeName %></div>
                                                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 3px;">
                                                        <span class="scan-qr-badge"><%= p.qrCodeToken %></span>
                                                        <span style="font-size: 11.5px; color: #64748b;"><%= p.attendeeEmail %></span>
                                                    </div>
                                                </div>

                                                <!-- Station / Booth -->
                                                <div>
                                                    <strong style="color: #0d1b54;"><%= p.boothName %></strong>
                                                    <span style="display: block; font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700;"><%= p.boothType %></span>
                                                </div>

                                                <!-- Event -->
                                                <span><%= p.eventName %></span>

                                                <!-- Points Pill -->
                                                <div>
                                                    <% if (p.points >= 100) { %>
                                                        <span class="points-pill points-pill-green">+<%= p.points %> PTS</span>
                                                    <% } else if (p.points >= 65) { %>
                                                        <span class="points-pill points-pill-blue">+<%= p.points %> PTS</span>
                                                    <% } else { %>
                                                        <span class="points-pill points-pill-amber">+<%= p.points %> PTS</span>
                                                    <% } %>
                                                </div>

                                                <!-- Timestamp -->
                                                <div>
                                                    <div style="font-weight: 700; color: #1e293b;"><%= p.timeFormatted %></div>
                                                    <div style="font-size: 11px; color: #94a3b8;"><%= p.dateFormatted %> (<%= p.timeAgo %>)</div>
                                                </div>

                                                <!-- Actions -->
                                                <div class="table-cell-actions">
                                                    <button class="btn-action-edit" type="button"
                                                            data-id="<%= p.id %>"
                                                            data-attendeedbid="<%= p.attendeeDbId %>"
                                                            data-attendeename="<%= p.attendeeName %>"
                                                            data-qrid="<%= p.qrCodeToken %>"
                                                            data-boothid="<%= p.boothId %>"
                                                            data-eventid="<%= p.eventId %>"
                                                            data-points="<%= p.points %>"
                                                            data-category="<%= p.category %>"
                                                            onclick="openEditPoints(this)"
                                                            title="Edit Points">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M12 20h9"></path>
                                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                                        </svg>
                                                    </button>
                                                    <button class="btn-action-delete" type="button"
                                                            data-id="<%= p.id %>"
                                                            data-name="<%= p.attendeeName %> (<%= p.points %> PTS at <%= p.boothName %>)"
                                                            onclick="openDeletePoints(this)">
                                                        Delete
                                                    </button>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>

                                <!-- Pagination Bar (Matches Reference Layout) -->
                                <div class="table-pagination-bar" id="pointsPaginationBar">
                                    <div class="pagination-top-row">
                                        <div class="pagination-nav-group">
