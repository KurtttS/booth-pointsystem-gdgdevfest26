                                        <span>Total Scans:</span>
                                        <strong style="font-size: 15px; color: #1e40af;" id="eventTotalScansCount"><%= (typeof totalScans !== 'undefined' ? totalScans : 0).toLocaleString() %></strong>
                                    </div>
                                </div>

                                <button class="btn-pill-add" style="background: #4338ca; color: #ffffff;" type="button" id="openAddEventModal">
                                    Add Event +
                                </button>
                            </div>

