    <!-- Client-side Interactions -->
    <script>
    // Password visibility toggle for login card
    const adminPasswordInput = document.getElementById('adminPassword');
    const toggleAdminPassword = document.getElementById('toggleAdminPassword');
    const adminEyeIcon = document.getElementById('adminEyeIcon');

    if (toggleAdminPassword && adminPasswordInput && adminEyeIcon) {
        toggleAdminPassword.addEventListener('click', () => {
            const isHidden = adminPasswordInput.type === 'password';
            adminPasswordInput.type = isHidden ? 'text' : 'password';
            adminEyeIcon.innerHTML = isHidden
                ? '<path d="M3 2 2 3l4 4C3.5 8.6 1.9 10.5 1.5 11.1a1.5 1.5 0 0 0 0 1.8C2.6 14.5 6.8 19 12 19c1.7 0 3.3-.5 4.7-1.2l3.3 3.3 1-1L3 2Zm9 14.2a4.2 4.2 0 0 1-4.2-4.2c0-.7.2-1.4.5-2l5.7 5.7c-.6.3-1.3.5-2 .5ZM12 5c-1.3 0-2.6.3-3.8.8l2 2A4.2 4.2 0 0 1 16.2 14l2.2 2.2c2.1-1.4 3.6-3.1 4.1-3.9a1.5 1.5 0 0 0 0-1.8C21.4 9.5 17.2 5 12 5Zm0 11.2a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm0-2.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Z"></path>'
                : '<path d="M12 5c-5.2 0-9.4 4.5-10.5 6.1a1.5 1.5 0 0 0 0 1.8C2.6 14.5 6.8 19 12 19s9.4-4.5 10.5-6.1a1.5 1.5 0 0 0 0-1.8C21.4 9.5 17.2 5 12 5Zm0 11.2a4.2 4.2 0 1 1 0-8.4 4.2 4.2 0 0 1 0 8.4Zm0-2.3a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Z"></path>';
        });
    }

    // Modal Helper functions
    function openModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.add('is-open');
    }
    function closeModal(id) {
        const el = document.getElementById(id);
        if (el) el.classList.remove('is-open');
    }

    // Close modal on click outside dialog
    document.querySelectorAll('.modal-backdrop').forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) modal.classList.remove('is-open');
        });
    });

    // Attendees Add Modal Button
    const openAddAttendeeBtn = document.getElementById('openAddAttendeeModal');
    if (openAddAttendeeBtn) {
        openAddAttendeeBtn.addEventListener('click', () => openModal('addAttendeeModal'));
    }

    // Edit Attendee Modal Handler
    function openEditAttendee(btn) {
        document.getElementById('editAttendeeDbId').value = btn.dataset.id;
        document.getElementById('editAttendeeQrId').value = btn.dataset.qrid || '';
        document.getElementById('editAttendeeFirstName').value = btn.dataset.firstname || '';
        document.getElementById('editAttendeeLastName').value = btn.dataset.lastname || '';
        document.getElementById('editAttendeeEmail').value = btn.dataset.email || '';
        if (btn.dataset.eventid) {
            document.getElementById('editAttendeeEventId').value = btn.dataset.eventid;
        }
        openModal('editAttendeeModal');
    }

    // Delete Attendee Modal Handler
    function openDeleteAttendee(btn) {
        document.getElementById('deleteAttendeeDbId').value = btn.dataset.id;
        document.getElementById('deleteAttendeeName').textContent = btn.dataset.name || 'this attendee';
        openModal('deleteAttendeeModal');
    }

    // Booths Add Modal Button
    const openAddBoothBtn = document.getElementById('openAddBoothModal');
    if (openAddBoothBtn) {
        openAddBoothBtn.addEventListener('click', () => openModal('addBoothModal'));
    }

    // Edit Booth Modal Handler
    function openEditBooth(btn) {
        document.getElementById('editBoothId').value = btn.dataset.id;
        const usernameEl = document.getElementById('editBoothUsername');
        if (usernameEl) {
            usernameEl.value = btn.dataset.username || btn.dataset.id || '';
        }
        const pwdEl = document.getElementById('editBoothPassword');
        if (pwdEl) pwdEl.value = '';
        document.getElementById('editBoothName').value = btn.dataset.name || '';
        document.getElementById('editBoothLocation').value = btn.dataset.location || '';
        document.getElementById('editBoothDesc').value = btn.dataset.desc || '';
        document.getElementById('editBoothSponsor').value = btn.dataset.sponsor || '';
        document.getElementById('editBoothType').value = btn.dataset.type || 'standard';
        openModal('editBoothModal');
    }

    // Delete Booth Modal Handler
    function openDeleteBooth(btn) {
        document.getElementById('deleteBoothId').value = btn.dataset.id;
        document.getElementById('deleteBoothName').textContent = btn.dataset.name || btn.dataset.id;
        openModal('deleteBoothModal');
    }

    // Points Add Modal Button
    const openAddPointsBtn = document.getElementById('openAddPointsModal');
    if (openAddPointsBtn) {
        openAddPointsBtn.addEventListener('click', () => openModal('addPointsModal'));
    }

    // Edit Points Modal Handler
    function openEditPoints(btn) {
        document.getElementById('editPointsId').value = btn.dataset.id;
        document.getElementById('editPointsAttendeeDisplay').value = (btn.dataset.attendeename || '') + (btn.dataset.qrid ? ' (' + btn.dataset.qrid + ')' : '');
        document.getElementById('editPointsAttendeeId').value = btn.dataset.attendeedbid || '';
        if (btn.dataset.boothid) {
            document.getElementById('editPointsBooth').value = btn.dataset.boothid;
        }
        if (btn.dataset.eventid) {
            document.getElementById('editPointsEvent').value = btn.dataset.eventid;
        }
        document.getElementById('editPointsAmount').value = btn.dataset.points || '100';
        if (btn.dataset.category) {
            document.getElementById('editPointsCategory').value = btn.dataset.category;
        }
        openModal('editPointsModal');
    }

    // Delete Points Modal Handler
    function openDeletePoints(btn) {
        document.getElementById('deletePointsId').value = btn.dataset.id;
        document.getElementById('deletePointsName').textContent = btn.dataset.name || 'this record';
        openModal('deletePointsModal');
    }

    // Events Add Modal Button
    const openAddEventBtn = document.getElementById('openAddEventModal');
    if (openAddEventBtn) {
        openAddEventBtn.addEventListener('click', () => openModal('addEventModal'));
    }

    // Edit Event Modal Handler
    function openEditEvent(btn) {
        document.getElementById('editEventId').value = btn.dataset.id;
        document.getElementById('editEventName').value = btn.dataset.name || '';
        document.getElementById('editEventVenue').value = btn.dataset.venue || '';
        if (btn.dataset.date) {
            // Format to YYYY-MM-DD if date contains time
            const dateStr = btn.dataset.date.split('T')[0];
            document.getElementById('editEventDate').value = dateStr;
        } else {
            document.getElementById('editEventDate').value = '';
        }
        openModal('editEventModal');
    }

    // Delete Event Modal Handler
    function openDeleteEvent(btn) {
        document.getElementById('deleteEventId').value = btn.dataset.id;
        document.getElementById('deleteEventName').textContent = btn.dataset.name || 'this event';
        openModal('deleteEventModal');
    }

    // Close all open popovers (standard exclusive dropdown practice)
    function closeAllDropdowns(exceptPopover = null) {
        document.querySelectorAll('.dropdown-popover.is-open').forEach(p => {
            if (p !== exceptPopover) {
                p.classList.remove('is-open');
            }
        });
    }

    // Dropdown Popovers Toggle - Exclusive (Only one open at a time)
    function setupDropdown(toggleId, popoverId) {
        const toggle = document.getElementById(toggleId);
        const popover = document.getElementById(popoverId);
        if (toggle && popover) {
            toggle.addEventListener('click', (e) => {
                e.stopPropagation();
                const willOpen = !popover.classList.contains('is-open');
                // Standard Practice: close all other open dropdowns first
                closeAllDropdowns(willOpen ? popover : null);
                if (willOpen) {
                    popover.classList.add('is-open');
                } else {
                    popover.classList.remove('is-open');
                }
            });
        }
    }

    // Global listener to close open popovers on click outside
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.dropdown-popover') && !e.target.closest('.dropdown-menu-container')) {
            closeAllDropdowns();
        }
    });

    setupDropdown('overviewFilterToggle', 'overviewFilterPopover');
    setupDropdown('attendeesFilterToggle', 'attendeesFilterPopover');
    setupDropdown('boothsDropdownToggle', 'boothsDropdownPopover');
    setupDropdown('boothDetailDropdownToggle', 'boothDetailDropdownPopover');
    setupDropdown('boothsTypeFilterToggle', 'boothsTypeFilterPopover');
    setupDropdown('boothSortToggle', 'boothSortPopover');
    setupDropdown('pointsEventFilterToggle', 'pointsEventFilterPopover');
    setupDropdown('pointsBoothFilterToggle', 'pointsBoothFilterPopover');
    setupDropdown('eventsFilterToggle', 'eventsFilterPopover');

    // Sliding window pagination algorithm matching reference screenshot (< 1 2 [3] 4 5 ... 22 >)
    function buildPaginationItems(current, total) {
        if (total <= 7) {
            const pages = [];
            for (let i = 1; i <= total; i++) pages.push(i);
            return pages;
        }
        if (current <= 4) {
            return [1, 2, 3, 4, 5, '...', total];
        }
        if (current >= total - 3) {
            return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
        }
        return [1, '...', current - 1, current, current + 1, '...', total];
    }

    // ==========================================
    // ATTENDEE PAGINATION & REAL-TIME SEARCH
    // ==========================================
    const allAttendeeRows = Array.from(document.querySelectorAll('.table-row-attendee'));
    let attendeePageSize = 10;
    let currentPageNum = 1;
    let visibleAttendeeRows = [...allAttendeeRows];

    const attendeesPageSizeSelect = document.getElementById('attendeesPageSizeSelect');
    if (attendeesPageSizeSelect) {
        attendeesPageSizeSelect.addEventListener('change', (e) => {
            attendeePageSize = parseInt(e.target.value, 10) || 10;
            currentPageNum = 1;
            renderAttendeePagination();
        });
    }

    function renderAttendeePagination() {
        const total = visibleAttendeeRows.length;
        const totalPages = Math.max(1, Math.ceil(total / attendeePageSize));
        if (currentPageNum > totalPages) currentPageNum = totalPages;
        if (currentPageNum < 1) currentPageNum = 1;

        const startIndex = (currentPageNum - 1) * attendeePageSize;
        const endIndex = Math.min(startIndex + attendeePageSize, total);

        // Hide all rows, show only rows for this page
        allAttendeeRows.forEach(row => row.style.display = 'none');
        for (let i = startIndex; i < endIndex; i++) {
            if (visibleAttendeeRows[i]) {
                visibleAttendeeRows[i].style.display = 'grid';
            }
        }

        // Update pagination counter text (Results: 1 - 10 of 324)
        const pagStartEl = document.getElementById('pagStart');
        const pagEndEl = document.getElementById('pagEnd');
        const pagTotalEl = document.getElementById('pagTotal');
        if (pagStartEl) pagStartEl.textContent = total > 0 ? (startIndex + 1) : 0;
        if (pagEndEl) pagEndEl.textContent = endIndex;
        if (pagTotalEl) pagTotalEl.textContent = total;

        // Prev & Next button state
        const prevBtn = document.getElementById('pagPrevBtn');
        const nextBtn = document.getElementById('pagNextBtn');
        if (prevBtn) prevBtn.disabled = (currentPageNum <= 1);
        if (nextBtn) nextBtn.disabled = (currentPageNum >= totalPages);

        // Render page buttons matching screenshot
        const pagesContainer = document.getElementById('pagPageNumbers');
        if (pagesContainer) {
            pagesContainer.innerHTML = '';
            const items = buildPaginationItems(currentPageNum, totalPages);
            items.forEach(item => {
                if (item === '...') {
                    const el = document.createElement('span');
                    el.className = 'pagination-ellipsis';
                    el.textContent = '...';
                    pagesContainer.appendChild(el);
                } else {
                    const pBtn = document.createElement('button');
                    pBtn.type = 'button';
                    pBtn.className = `btn-page-num ${item === currentPageNum ? 'active' : ''}`;
                    pBtn.textContent = item;
                    pBtn.setAttribute('aria-label', `Page ${item}`);
                    if (item === currentPageNum) {
                        pBtn.setAttribute('aria-current', 'page');
                    }
                    pBtn.addEventListener('click', () => {
                        currentPageNum = item;
                        renderAttendeePagination();
                    });
                    pagesContainer.appendChild(pBtn);
                }
            });
        }
    }

    const prevBtn = document.getElementById('pagPrevBtn');
    if (prevBtn) {
        prevBtn.addEventListener('click', () => {
            if (currentPageNum > 1) {
                currentPageNum--;
                renderAttendeePagination();
            }
        });
    }

    const nextBtn = document.getElementById('pagNextBtn');
    if (nextBtn) {
        nextBtn.addEventListener('click', () => {
            currentPageNum++;
            renderAttendeePagination();
        });
    }

    // Real-time Attendee Table Search Filter Integrated with Pagination
    const searchInput = document.getElementById('attendeeSearchInput');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = (e.target.value || '').trim().toLowerCase();
            visibleAttendeeRows = allAttendeeRows.filter(row => {
                const searchData = row.dataset.search || '';
                return (!query || searchData.includes(query));
            });
            currentPageNum = 1;
            renderAttendeePagination();
        });
    }

    if (allAttendeeRows.length > 0) {
        renderAttendeePagination();
    }

    // ==========================================
    // BOOTHS REAL-TIME CLIENT-SIDE SEARCH, FILTER & SORT
    // ==========================================
    const boothSearchInput = document.getElementById('boothSearchInput');
    const boothSortSelect = document.getElementById('boothSortSelect');
    const boothFilterLabel = document.getElementById('boothTypeFilterLabel');
    const boothFilterButtons = document.querySelectorAll('.booth-filter-opt');
    const boothsTableBody = document.getElementById('boothsTableBody');
    const allBoothRows = Array.from(document.querySelectorAll('.table-row-booth'));

    let currentBoothType = 'all';
    let currentBoothQuery = (boothSearchInput ? boothSearchInput.value : '').trim().toLowerCase();

    function applyBoothFilterAndSort() {
        if (!boothsTableBody || allBoothRows.length === 0) return;

        // 1. Filter rows by type and search query
        allBoothRows.forEach(row => {
            const rowType = (row.dataset.type || 'standard').toLowerCase();
            const rowSearch = (row.dataset.search || '').toLowerCase();
            const matchesType = (currentBoothType === 'all' || rowType === currentBoothType);
            const matchesQuery = (!currentBoothQuery || rowSearch.includes(currentBoothQuery));
            row.style.display = (matchesType && matchesQuery) ? 'grid' : 'none';
        });

        // 2. Sort rows based on selected sort option
        const sortVal = boothSortSelect ? boothSortSelect.value : 'name_asc';
        const sortedRows = [...allBoothRows].sort((a, b) => {
            if (sortVal === 'name_asc') {
                return (a.dataset.name || '').localeCompare(b.dataset.name || '');
            } else if (sortVal === 'name_desc') {
                return (b.dataset.name || '').localeCompare(a.dataset.name || '');
            } else if (sortVal === 'date_desc') {
                const dateA = new Date(a.dataset.date || 0).getTime() || 0;
                const dateB = new Date(b.dataset.date || 0).getTime() || 0;
                return dateB - dateA;
            } else if (sortVal === 'date_asc') {
                const dateA = new Date(a.dataset.date || 0).getTime() || 0;
                const dateB = new Date(b.dataset.date || 0).getTime() || 0;
                return dateA - dateB;
            }
            return 0;
        });

        // Re-append sorted rows to DOM
        sortedRows.forEach(r => boothsTableBody.appendChild(r));
    }

    if (boothSearchInput) {
        boothSearchInput.addEventListener('input', (e) => {
            currentBoothQuery = (e.target.value || '').trim().toLowerCase();
            applyBoothFilterAndSort();
        });
    }

    if (boothSortSelect) {
        boothSortSelect.addEventListener('change', () => {
            applyBoothFilterAndSort();
        });
    }

    const boothSortOpts = document.querySelectorAll('.booth-sort-opt');
    const boothSortLabel = document.getElementById('boothSortLabel');
    boothSortOpts.forEach(btn => {
        btn.addEventListener('click', () => {
            const sortVal = btn.dataset.sort || 'name_asc';
            const sortLabelText = btn.dataset.label || 'Sort: Name A-Z';
            if (boothSortSelect) {
                boothSortSelect.value = sortVal;
            }
            if (boothSortLabel) {
                boothSortLabel.textContent = sortLabelText;
            }
            boothSortOpts.forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');

            const popover = document.getElementById('boothSortPopover');
            if (popover) popover.classList.remove('is-open');

            applyBoothFilterAndSort();
        });
    });

    boothFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            currentBoothType = btn.dataset.type || 'all';
            const labelText = btn.dataset.label || 'All Types';
            if (boothFilterLabel) {
                boothFilterLabel.textContent = `Filter: ${labelText.toUpperCase()}`;
            }
            boothFilterButtons.forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');

            const popover = document.getElementById('boothsTypeFilterPopover');
            if (popover) popover.classList.remove('is-open');

            applyBoothFilterAndSort();
        });
    });

    // ==========================================
    // POINTS REAL-TIME SEARCH, FILTER & PAGINATION
    // ==========================================
    const allPointsRows = Array.from(document.querySelectorAll('.table-row-points-item'));
    let pointsPageSize = 10;
    let currentPointsPage = 1;
    let currentPointsEvent = 'all';
    let currentPointsBooth = 'all';
    let currentPointsQuery = '';
    let visiblePointsRows = [...allPointsRows];

    const pointsPageSizeSelect = document.getElementById('pointsPageSizeSelect');
    if (pointsPageSizeSelect) {
        pointsPageSizeSelect.addEventListener('change', (e) => {
            pointsPageSize = parseInt(e.target.value, 10) || 10;
            currentPointsPage = 1;
            renderPointsPagination();
        });
    }

    function applyPointsFilterAndPagination() {
        visiblePointsRows = allPointsRows.filter(row => {
            const searchData = (row.dataset.search || '').toLowerCase();
            const rowEventId = (row.dataset.eventid || '').toString();
            const rowBoothId = (row.dataset.boothid || '').toString().toLowerCase();

            const matchesQuery = (!currentPointsQuery || searchData.includes(currentPointsQuery));
            const matchesEvent = (currentPointsEvent === 'all' || rowEventId === currentPointsEvent.toString());
            const matchesBooth = (currentPointsBooth === 'all' || rowBoothId === currentPointsBooth.toLowerCase());

            return matchesQuery && matchesEvent && matchesBooth;
        });

        currentPointsPage = 1;
        renderPointsPagination();
    }

    function renderPointsPagination() {
        const total = visiblePointsRows.length;
        const totalPages = Math.max(1, Math.ceil(total / pointsPageSize));
        if (currentPointsPage > totalPages) currentPointsPage = totalPages;
        if (currentPointsPage < 1) currentPointsPage = 1;

        const startIndex = (currentPointsPage - 1) * pointsPageSize;
        const endIndex = Math.min(startIndex + pointsPageSize, total);

        allPointsRows.forEach(row => row.style.display = 'none');
        for (let i = startIndex; i < endIndex; i++) {
            if (visiblePointsRows[i]) {
                visiblePointsRows[i].style.display = 'grid';
            }
        }

        // Update results counter (Results: 1 - 10 of 324)
        const startEl = document.getElementById('ptsPagStart');
        const endEl = document.getElementById('ptsPagEnd');
        const totalEl = document.getElementById('ptsPagTotal');
        if (startEl) startEl.textContent = total > 0 ? (startIndex + 1) : 0;
        if (endEl) endEl.textContent = endIndex;
        if (totalEl) totalEl.textContent = total;

        const prevPtsBtn = document.getElementById('ptsPagPrevBtn');
        const nextPtsBtn = document.getElementById('ptsPagNextBtn');
        if (prevPtsBtn) prevPtsBtn.disabled = (currentPointsPage <= 1);
        if (nextPtsBtn) nextPtsBtn.disabled = (currentPointsPage >= totalPages);

        const pagesContainer = document.getElementById('ptsPagPageNumbers');
        if (pagesContainer) {
            pagesContainer.innerHTML = '';
            const items = buildPaginationItems(currentPointsPage, totalPages);
            items.forEach(item => {
                if (item === '...') {
                    const el = document.createElement('span');
                    el.className = 'pagination-ellipsis';
                    el.textContent = '...';
                    pagesContainer.appendChild(el);
                } else {
                    const pBtn = document.createElement('button');
                    pBtn.type = 'button';
                    pBtn.className = `btn-page-num ${item === currentPointsPage ? 'active' : ''}`;
                    pBtn.textContent = item;
                    pBtn.setAttribute('aria-label', `Page ${item}`);
                    if (item === currentPointsPage) {
                        pBtn.setAttribute('aria-current', 'page');
                    }
                    pBtn.addEventListener('click', () => {
                        currentPointsPage = item;
                        renderPointsPagination();
                    });
                    pagesContainer.appendChild(pBtn);
                }
            });
        }
    }

    const prevPtsBtn = document.getElementById('ptsPagPrevBtn');
    if (prevPtsBtn) {
        prevPtsBtn.addEventListener('click', () => {
            if (currentPointsPage > 1) {
                currentPointsPage--;
                renderPointsPagination();
            }
        });
    }

    const nextPtsBtn = document.getElementById('ptsPagNextBtn');
    if (nextPtsBtn) {
        nextPtsBtn.addEventListener('click', () => {
            currentPointsPage++;
            renderPointsPagination();
        });
    }

    const pointsSearchInput = document.getElementById('pointsSearchInput');
    if (pointsSearchInput) {
        pointsSearchInput.addEventListener('input', (e) => {
            currentPointsQuery = (e.target.value || '').trim().toLowerCase();
            applyPointsFilterAndPagination();
        });
    }

    // Points Event Filter Dropdown items
    const pointsEventFilterLabel = document.getElementById('pointsEventFilterLabel');
    const pointsEventFilterButtons = document.querySelectorAll('.points-event-filter-opt');
    pointsEventFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            currentPointsEvent = btn.dataset.eventid || 'all';
            const label = btn.dataset.label || 'All Events';
            if (pointsEventFilterLabel) {
                pointsEventFilterLabel.textContent = `Event: ${label}`;
            }
            pointsEventFilterButtons.forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');

            const popover = document.getElementById('pointsEventFilterPopover');
            if (popover) popover.classList.remove('is-open');

            applyPointsFilterAndPagination();
        });
    });

    // Points Booth Filter Dropdown items
    const pointsBoothFilterLabel = document.getElementById('pointsBoothFilterLabel');
    const pointsBoothFilterButtons = document.querySelectorAll('.points-booth-filter-opt');
    pointsBoothFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            currentPointsBooth = btn.dataset.boothid || 'all';
            const label = btn.dataset.label || 'All Booths';
            if (pointsBoothFilterLabel) {
                pointsBoothFilterLabel.textContent = `Booth: ${label}`;
            }
            pointsBoothFilterButtons.forEach(b => b.classList.remove('is-selected'));
            btn.classList.add('is-selected');

            const popover = document.getElementById('pointsBoothFilterPopover');
            if (popover) popover.classList.remove('is-open');

            applyPointsFilterAndPagination();
        });
    });

    if (allPointsRows.length > 0) {
        renderPointsPagination();
    }
    </script>
    <script src="/JAVASCRIPT/nav.js" defer></script>
</body>
</html>

