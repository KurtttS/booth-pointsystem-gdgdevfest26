                                    <span>Event Name</span>
                                    <span>Venue</span>
                                    <span>Date</span>
                                    <span>Attendees</span>
                                    <span>Total Scans</span>
                                    <span>Actions</span>
                                </div>

                                <div id="eventsTableBody">
