<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DevFest Bacolod 2026 - Leaderboard</title>

    <!-- Browser tab icon -->
    <link rel="icon" type="image/png" href="/IMG/GDGTOP.png">

    <!-- Page stylesheet -->
    <link rel="stylesheet" href="/CSS/Leaderboard.css">
    <link rel="stylesheet" href="/CSS/nav.css">
</head>

<body>

<div class="page-shell">

    <!-- Shared navbar -->
    <%- include('partials/nav', { currentPage: 'Leaderboard.php', isLoggedIn: (typeof isLoggedIn !== 'undefined' ? isLoggedIn : false), sid: (typeof sid !== 'undefined' ? sid : '') }) %>

    <!-- LEADERBOARD CONTENT -->
    <main class="leaderboard">

        <div class="ambient ambient-top"></div>
        <div class="ambient ambient-bottom"></div>

        <!-- TITLE -->
        <section class="page-heading">
            <h1>LEADERBOARD</h1>

            <div class="subtitle">
                <span></span>
                <p>TOP ATTENDEES PERFORMERS · <%= (typeof trackName !== 'undefined' && trackName) ? trackName.toUpperCase() : 'EVENT STANDINGS' %></p>
                <span></span>
            </div>

            <!-- LOCKED EVENT / TRACK BADGE (ONLY SHOWS THE CURRENT BOOTH EVENT) -->
            <% if (typeof currentEvent !== 'undefined' && currentEvent) { %>
            <div class="locked-event-banner" id="lockedEventBanner" data-event-id="<%= selectedEventId %>">
                <div class="locked-event-chip">
                    <span class="locked-event-dot"></span>
                    <span class="locked-event-name"><%= currentEvent.event_name %></span>
                    <span class="locked-event-tag">Current Event</span>
                </div>
                <% if (currentEvent.venue || currentEvent.event_date) { %>
                <div class="locked-event-meta">
                    <% if (currentEvent.venue) { %>
                        <span class="meta-tag meta-venue">📍 <%= currentEvent.venue %></span>
                    <% } %>
                    <% if (currentEvent.event_date) { %>
                        <span class="meta-tag meta-date">📅 <%= currentEvent.event_date %></span>
                    <% } %>
                </div>
                <% } %>
            </div>
            <% } %>
        </section>

        <% if (typeof top1 !== 'undefined' && top1) { %>
        <!-- TOP THREE PODIUM -->
        <section class="podium">

            <!-- SECOND PLACE -->
            <article class="podium-card second-place">

                <div class="avatar">
                    <span class="avatar-head"></span>
                    <span class="avatar-body"></span>
                </div>

                <div class="podium-info">
                    <h2><%= (top2 && top2.name) ? top2.name : (top2 ? top2.id : 'No Attendee') %></h2>
                    <% if (top2 && top2.name && top2.id) { %>
                        <span class="podium-subid"><%= top2.id %></span>
                    <% } %>
                    <p class="rank-label">TOP 2</p>
                    <span class="points"><%= top2 ? top2.points : 0 %> PTS</span>
                </div>

            </article>

            <!-- FIRST PLACE -->
            <article class="podium-card first-place">

                <div class="crown">♛</div>

                <div class="avatar avatar-first">
                    <span class="avatar-head"></span>
                    <span class="avatar-body"></span>
                </div>

                <div class="podium-info">
                    <h2><%= top1.name || top1.id %></h2>
                    <% if (top1.name && top1.id) { %>
                        <span class="podium-subid"><%= top1.id %></span>
                    <% } %>
                    <p class="rank-label">TOP 1</p>
                    <span class="points"><%= top1.points %> PTS</span>
                </div>

            </article>

            <!-- THIRD PLACE -->
            <article class="podium-card third-place">

                <div class="avatar">
                    <span class="avatar-head"></span>
                    <span class="avatar-body"></span>
                </div>

                <div class="podium-info">
                    <h2><%= (top3 && top3.name) ? top3.name : (top3 ? top3.id : 'No Attendee') %></h2>
                    <% if (top3 && top3.name && top3.id) { %>
                        <span class="podium-subid"><%= top3.id %></span>
                    <% } %>
                    <p class="rank-label">TOP 3</p>
                    <span class="points"><%= top3 ? top3.points : 0 %> PTS</span>
                </div>

            </article>

        </section>
        <% } else { %>
        <div class="no-scans-notice">
            <div class="no-scans-icon">🏆</div>
            <h3>No Attendee Points Recorded Yet</h3>
            <p>Scans recorded at booth terminals for <strong><%= typeof trackName !== 'undefined' ? trackName : 'this event' %></strong> will appear on this leaderboard in real time.</p>
        </div>
        <% } %>

        <!-- RANKINGS LIST (TOP 4 - 7) -->
        <% if (typeof ranks4to7 !== 'undefined' && ranks4to7.length > 0) { %>
        <section class="rank-list">

            <% ranks4to7.forEach(function(item) { %>
            <article class="rank-row">
                <span class="rank-number"><%= item.rank %></span>
                <div class="rank-user-info">
                    <strong><%= item.name || item.id %></strong>
                    <% if (item.name && item.id) { %>
                        <span class="rank-sub-id"><%= item.id %></span>
                    <% } %>
                </div>
                <span class="row-points"><%= item.points %> PTS</span>
            </article>
            <% }); %>

            <!-- CONTINUATION (RANKS 8+) HIDDEN BY DEFAULT -->
            <% if (typeof ranks8to12 !== 'undefined' && ranks8to12.length > 0) { %>
            <div class="more-rankings" id="moreRankings">
                <% ranks8to12.forEach(function(item) { %>
                <article class="rank-row">
                    <span class="rank-number"><%= item.rank %></span>
                    <div class="rank-user-info">
                        <strong><%= item.name || item.id %></strong>
                        <% if (item.name && item.id) { %>
                            <span class="rank-sub-id"><%= item.id %></span>
                        <% } %>
                    </div>
                    <span class="row-points"><%= item.points %> PTS</span>
                </article>
                <% }); %>
            </div>
            <% } %>

        </section>
        <% } %>

        <!-- VIEW MORE / SHOW LESS BUTTON -->
        <% if (typeof ranks8to12 !== 'undefined' && ranks8to12.length > 0) { %>
        <button
            class="full-standings-btn"
            id="fullStandingsBtn"
            type="button"
            aria-expanded="false"
            aria-controls="moreRankings"
        >
            View More Rankings (<%= ranks8to12.length %> more) <span>↓</span>
        </button>
        <% } %>

        <!-- FOOTER -->
        <footer>
            © 2026 GDG BACOLOD - AI Innovations Team. All Rights Reserved
        </footer>

    </main>

</div>

<script src="/JAVASCRIPT/Leaderboard.js" defer></script>
<script src="/JAVASCRIPT/nav.js" defer></script>
</body>
</html>
