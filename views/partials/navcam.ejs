<%
    const cur = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : '';
    const isLogin = (cur === 'LoginBooth.php' || cur === 'LoginBooth');
    const isTrackChoice = (cur === 'EventChoices.php' || cur === 'EventChoices');
    const isScanner = (cur === 'scanner.php' || cur === 'scanner');
    const isLeaderboard = (cur === 'Leaderboard.php' || cur === 'Leaderboard');
    const isSuperAdmin = (cur === 'SuperAdmin.php' || cur === 'SuperAdmin');
    const loggedIn = (typeof isLoggedIn !== 'undefined' && isLoggedIn);
    const sessionSid = (typeof sid !== 'undefined' && sid) ? sid : '';
    const sidParam = sessionSid ? ('?sid=' + encodeURIComponent(sessionSid)) : '';
%>
<header class="topbar">

    <a class="brand" href="<%= loggedIn ? ('/EventChoices.php' + sidParam) : '/LoginBooth.php' %>"
       aria-label="DevFest Bacolod 2026 home">

        <img src="/IMG/GDG_LOGO.png"
             alt="DevFest Logo"
             class="gdg-logo">

        <span class="brand-copy">
            <span class="brand-name">DevFest</span>
            <span class="brand-location">Bacolod 2026</span>
        </span>

    </a>

    <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Toggle navigation"
        aria-controls="navLinks"
        aria-expanded="false">
        ☰
    </button>

    <nav class="nav-links" id="navLinks" aria-label="Main navigation">

        <% if (isLogin || !loggedIn) { %>
            <!-- 1. LOGIN / UNAUTHENTICATED: Cannot access Scanner and Leaderboard -->
            <a href="/LoginBooth.php<%= sidParam %>"
               class="<%= isLogin ? 'active' : '' %>">
                Booth Portal
            </a>

            <a href="/SuperAdmin.php<%= sidParam %>"
               class="<%= isSuperAdmin ? 'active' : '' %>">
                SuperAdmin
            </a>

        <% } else if (isTrackChoice) { %>
            <!-- 2. TRACK SELECTION: Cannot access Scanner and Leaderboard -->
            <a href="/EventChoices.php<%= sidParam %>"
               class="active">
                Track Selection
            </a>

            <a href="/logout.php<%= sidParam %>"
               class="logout-link"
               style="color: #ea4335;">
                Logout
            </a>

        <% } else { %>
            <!-- 3. SCANNER & LEADERBOARD: Can access each other and Track Selection -->
            <a href="/EventChoices.php<%= sidParam %>">
                Track Selection
            </a>

            <a href="/scanner.php<%= sidParam %>"
               class="<%= isScanner ? 'active' : '' %>">
                Scanner
            </a>

            <a href="/Leaderboard.php<%= sidParam %>"
               class="<%= isLeaderboard ? 'active' : '' %>">
                Leaderboard
            </a>

            <a href="/logout.php<%= sidParam %>"
               class="logout-link"
               style="color: #ea4335;">
                Logout
            </a>
        <% } %>

    </nav>

</header>
