<%
    const cur = (typeof currentPage !== 'undefined' && currentPage) ? currentPage.toLowerCase() : '';
    const isLogin = (cur.includes('login'));
    const isDashboard = (cur.includes('dashboard'));
    const isScanner = (cur.includes('scanner'));
    const isLeaderboard = (cur.includes('leaderboard'));
    const isSuperAdmin = (cur.includes('superadmin') || cur.includes('admin'));
    const isProfile = (cur.includes('profile') || cur.includes('stationprofile'));
    const isChoices = (cur.includes('choice') || cur.includes('eventchoices'));
    const loggedIn = (typeof isLoggedIn !== 'undefined' && isLoggedIn);
    const adminMode = (typeof isAdmin !== 'undefined' && isAdmin);
    const tab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'overview';

    let homeUrl = '/leaderboard';
    if (loggedIn) {
        homeUrl = adminMode ? '/superadmin?tab=overview' : '/dashboard';
    }
%>
<header class="topbar">

    <a class="brand" href="<%= homeUrl %>"
       aria-label="DevFest Bacolod 2026 home">

        <img src="/IMG/GDG_LOGO.png"
             alt="DevFest Logo"
             class="gdg-logo">

        <span class="brand-copy">
            <span class="brand-name">DevFest</span>
            <span class="brand-location">Bacolod 2026</span>
        </span>

    </a>

    <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Toggle navigation"
        aria-controls="navLinks"
        aria-expanded="false">
        ☰
    </button>

    <nav class="nav-links" id="navLinks" aria-label="Main navigation">

        <% if (loggedIn && adminMode) { %>
            <!-- 1. SUPER ADMIN NAVIGATION -->
            <a href="/superadmin?tab=overview"
               class="<%= tab === 'overview' ? 'active' : '' %>">
                Overview
            </a>

            <a href="/superadmin?tab=attendees"
               class="<%= tab === 'attendees' ? 'active' : '' %>">
                Attendees
            </a>

            <a href="/superadmin?tab=booths"
               class="<%= tab === 'booths' ? 'active' : '' %>">
                Booth
            </a>

            <a href="/superadmin?tab=points"
               class="<%= tab === 'points' ? 'active' : '' %>">
                Points
            </a>

            <a href="/superadmin?tab=events"
               class="<%= tab === 'events' ? 'active' : '' %>">
                Events
            </a>

            <a href="/logout?role=admin"
               class="superadmin-logout-btn">
                Log Out
            </a>


        <% } else if (!loggedIn) { %>
            <!-- 2. UNAUTHENTICATED / GUEST: On leaderboard, only Login is in header; on login, show Leaderboard & Login -->
            <% if (isLeaderboard) { %>
                <a href="/login">
                    Login
                </a>
            <% } else { %>
                <a href="/leaderboard"
                   class="<%= isLeaderboard ? 'active' : '' %>">
                    Leaderboard
                </a>

                <a href="/login"
                   class="<%= isLogin ? 'active' : '' %>">
                    Login
                </a>

                <a href="/superadmin"
                   class="<%= isSuperAdmin ? 'active' : '' %>">
                    SuperAdmin
                </a>
            <% } %>

        <% } else { %>
            <!-- 3. AUTHENTICATED BOOTH USER: Dashboard, Scanner, Events, Leaderboard, and Station Profile Icon -->
            <a href="/dashboard"
               class="<%= isDashboard ? 'active' : '' %>">
                Dashboard
            </a>

            <a href="/scanner"
               class="<%= isScanner ? 'active' : '' %>">
                Scanner
            </a>

            <a href="/choices"
               class="<%= isChoices ? 'active' : '' %>"
               title="Event Selection">
                Events
            </a>

            <a href="/leaderboard"
               class="<%= isLeaderboard ? 'active' : '' %>">
                Leaderboard
            </a>

            <a href="/stationprofile"
               class="profile-btn <%= isProfile ? 'active' : '' %>"
               aria-label="Station Profile"
               title="Station Profile">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </a>
        <% } %>

    </nav>

</header>
