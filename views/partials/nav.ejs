<%
    const cur = (typeof currentPage !== 'undefined' && currentPage) ? currentPage : '';
    const isLogin = (cur === 'LoginBooth.php' || cur === 'LoginBooth');
    const isDashboard = (cur === 'Dashboard.php' || cur === 'Dashboard');
    const isScanner = (cur === 'scanner.php' || cur === 'scanner');
    const isLeaderboard = (cur === 'Leaderboard.php' || cur === 'Leaderboard');
    const isSuperAdmin = (cur === 'SuperAdmin.php' || cur === 'SuperAdmin');
    const isProfile = (cur === 'StationProfile.php' || cur === 'StationProfile');
    const isChoices = (cur === 'EventChoices.php' || cur === 'EventChoices');
    const loggedIn = (typeof isLoggedIn !== 'undefined' && isLoggedIn);
    const adminMode = (typeof isAdmin !== 'undefined' && isAdmin);
    const tab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'overview';
    const sessionSid = (typeof sid !== 'undefined' && sid) ? sid : '';
    const sidParam = sessionSid ? ('?sid=' + encodeURIComponent(sessionSid)) : '';
    const sidQuery = sessionSid ? ('&sid=' + encodeURIComponent(sessionSid)) : '';

    let homeUrl = '/Leaderboard.php' + sidParam;
    if (loggedIn) {
        homeUrl = adminMode ? ('/SuperAdmin.php?tab=overview' + sidQuery) : ('/Dashboard.php' + sidParam);
    }
%>
<header class="topbar">

    <a class="brand" href="<%= homeUrl %>"
       aria-label="DevFest Bacolod 2026 home">

        <img src="/IMG/GDG_LOGO.png"
             alt="DevFest Logo"
             class="gdg-logo">

        <span class="brand-copy">
            <span class="brand-name">DevFest</span>
            <span class="brand-location">Bacolod 2026</span>
        </span>

    </a>

    <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Toggle navigation"
        aria-controls="navLinks"
        aria-expanded="false">
        ☰
    </button>

    <nav class="nav-links" id="navLinks" aria-label="Main navigation">

        <% if (loggedIn && adminMode) { %>
            <!-- 1. SUPER ADMIN NAVIGATION (Screenshots 1, 2, 3, 4) -->
            <a href="/SuperAdmin.php?tab=overview<%= sidQuery %>"
               class="<%= tab === 'overview' ? 'active' : '' %>">
                Overview
            </a>

            <a href="/SuperAdmin.php?tab=attendees<%= sidQuery %>"
               class="<%= tab === 'attendees' ? 'active' : '' %>">
                Attendees
            </a>

            <a href="/SuperAdmin.php?tab=booths<%= sidQuery %>"
               class="<%= tab === 'booths' ? 'active' : '' %>">
                Booth
            </a>

            <a href="/logout.php?role=admin"
               class="superadmin-logout-btn">
                Log Out
            </a>

        <% } else if (!loggedIn) { %>
            <!-- 2. UNAUTHENTICATED / GUEST: On leaderboard, only Login is in header; on login, show Leaderboard & Login -->
            <% if (isLeaderboard) { %>
                <a href="/LoginBooth.php<%= sidParam %>">
                    Login
                </a>
            <% } else { %>
                <a href="/Leaderboard.php<%= sidParam %>"
                   class="<%= isLeaderboard ? 'active' : '' %>">
                    Leaderboard
                </a>

                <a href="/LoginBooth.php<%= sidParam %>"
                   class="<%= isLogin ? 'active' : '' %>">
                    Login
                </a>

                <a href="/SuperAdmin.php<%= sidParam %>"
                   class="<%= isSuperAdmin ? 'active' : '' %>">
                    SuperAdmin
                </a>
            <% } %>

        <% } else { %>
            <!-- 3. AUTHENTICATED BOOTH USER: Dashboard, Scanner, Events, Leaderboard, and Station Profile Icon -->
            <a href="/Dashboard.php<%= sidParam %>"
               class="<%= isDashboard ? 'active' : '' %>">
                Dashboard
            </a>

            <a href="/scanner.php<%= sidParam %>"
               class="<%= isScanner ? 'active' : '' %>">
                Scanner
            </a>

            <a href="/EventChoices.php<%= sidParam %>"
               class="<%= isChoices ? 'active' : '' %>"
               title="Event Selection">
                Events
            </a>

            <a href="/Leaderboard.php<%= sidParam %>"
               class="<%= isLeaderboard ? 'active' : '' %>">
                Leaderboard
            </a>

            <a href="/StationProfile.php<%= sidParam %>"
               class="profile-btn <%= isProfile ? 'active' : '' %>"
               aria-label="Station Profile"
               title="Station Profile">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </a>
        <% } %>

    </nav>

</header>
