<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DevFest Bacolod 2026 - Event Choices</title>

    <!-- Browser tab icon -->
    <link rel="icon" type="image/png" href="/IMG/GDGTOP.png?v=2">

    <!-- Google Fonts for DevFest Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Page stylesheets -->
    <link rel="stylesheet" href="/CSS/EventChoices.css">
    <link rel="stylesheet" href="/CSS/nav.css">
</head>

<body>

<%
    const activeEvId = (typeof eventId !== 'undefined' && eventId) ? parseInt(eventId, 10) : ((typeof track !== 'undefined' && track === 'professionals') ? 2 : 1);
    const activeTrack = (typeof track !== 'undefined' && track) ? track : (activeEvId === 2 ? 'professionals' : 'students');
    const sessionSid = (typeof sid !== 'undefined' && sid) ? sid : '';
    const sidParam = sessionSid ? ('?sid=' + encodeURIComponent(sessionSid)) : '';
    const activeName = (typeof currentEventName !== 'undefined' && currentEventName) ? currentEventName : (activeEvId === 2 ? 'Professional Dev Day' : 'Student Dev Day');
%>
<div class="devfest-page">
    
    <!-- Shared navbar -->
    <%- include('partials/nav', { currentPage: 'EventChoices.php', isLoggedIn: true, sid: sessionSid }) %>

    <!-- Main Stage with Vibrant DevFest Gradient Mesh -->
    <main class="devfest-stage">
        
        <!-- Ambient DevFest Color Blooms -->
        <div class="blur-orb blur-top-right-1"></div>
        <div class="blur-orb blur-top-right-2"></div>
        <div class="blur-orb blur-bottom-left"></div>
        <div class="blur-orb blur-mid-left"></div>
        <div class="blur-orb blur-mid-right"></div>
        <div class="blur-orb blur-bottom-center"></div>

        <!-- Central Frosted Glass Container -->
        <div class="frosted-modal">
            
            <!-- Interior Decorative Blobs -->
            <div class="card-interior-blob-1"></div>
            <div class="card-interior-blob-2"></div>

            <!-- DevFest Header (Logo + Title) -->
            <div class="devfest-logo-row">
                <!-- GDG DevFest Logo identical to top left navbar -->
                <img src="/IMG/GDG_LOGO.png" alt="DevFest Logo" class="gdg-logo">

                <div class="devfest-title-box">
                    <h1 class="devfest-main-title">DevFest</h1>
                    <span class="devfest-subtitle">Bacolod 2026</span>
                </div>
            </div>

            <!-- Current Active Event Status -->
            <div class="active-event-indicator-box">
                <span class="current-event-pill">
                    <span class="pulse-dot"></span>
                    Current Session Event: <strong><%= activeName %></strong>
                </span>
                <p class="current-event-guide">Select an event below to switch your booth terminal's active session without logging out.</p>
            </div>

            <!-- Track Selection Form -->
            <form method="POST" action="/scanner.php" id="eventChoicesForm">
                <input type="hidden" name="event_id" id="selectedEventId" value="<%= activeEvId %>">
                <input type="hidden" name="sid" value="<%= sessionSid %>">
                
                <div class="track-selection-grid">
                    <% 
                    const eventList = (typeof events !== 'undefined' && events && events.length > 0) ? events : [
                        { id: 1, event_name: 'Student Dev Day', venue: 'Bacolod City College' },
                        { id: 2, event_name: 'Professional Dev Day', venue: 'Bacolod City College' }
                    ];
                    const themeColors = [
                        { cardClass: 'track-card-students', bg: '#1b6837', titleColor: '#1b6837', tag: 'DEV DAY' },
                        { cardClass: 'track-card-professionals', bg: '#d93829', titleColor: '#d93829', tag: 'NETWORK DAY' },
                        { cardClass: 'track-card-gdg', bg: '#1a73e8', titleColor: '#1a73e8', tag: 'TECH SUMMIT' },
                        { cardClass: 'track-card-summit', bg: '#f9ab00', titleColor: '#b06000', tag: 'INNOVATION DAY' }
                    ];

                    eventList.forEach(function(ev, idx) {
                        const isSelected = (activeEvId === ev.id);
                        const theme = themeColors[idx % themeColors.length];
                        const nameParts = (ev.event_name || 'Event').trim().split(' ');
                        const mainPart = nameParts.length > 1 ? nameParts.slice(0, -1).join(' ') : nameParts[0];
                        const subPart = nameParts.length > 1 ? nameParts.slice(-1).join(' ') : 'TRACK';
                    %>
                    <label class="track-card <%= theme.cardClass %> <%= isSelected ? 'active' : '' %>" data-event-id="<%= ev.id %>" data-event-name="<%= ev.event_name %>">
                        <input type="radio" name="track_id" value="<%= ev.id %>" class="track-radio" data-event-id="<%= ev.id %>" <%= isSelected ? 'checked' : '' %>>
                        <div class="selection-check">✓</div>

                        <div class="track-icon-wrapper">
                            <% if (idx % 4 === 0) { %>
                                <svg width="104" height="104" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="44" cy="40" r="16" fill="<%= theme.bg %>" />
                                    <path d="M20 86C20 68 34 62 48 62C58 62 67 65 72 71C67 76 65 83 65 90H20V86Z" fill="<%= theme.bg %>" />
                                    <circle cx="78" cy="46" r="13" fill="<%= theme.bg %>" />
                                    <rect x="72" y="63" width="34" height="38" rx="12" fill="<%= theme.bg %>" />
                                    <rect x="79" y="73" width="18" height="4" rx="2" fill="#ffffff" />
                                    <rect x="79" y="82" width="13" height="4" rx="2" fill="#ffffff" />
                                </svg>
                            <% } else if (idx % 4 === 1) { %>
                                <svg width="104" height="104" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="36" cy="46" r="10" fill="<%= theme.bg %>" />
                                    <circle cx="56" cy="46" r="10" fill="<%= theme.bg %>" />
                                    <circle cx="48" cy="65" r="11" fill="<%= theme.bg %>" />
                                    <ellipse cx="32" cy="65" rx="11" ry="8" fill="<%= theme.bg %>" />
                                    <ellipse cx="48" cy="80" rx="14" ry="7" fill="<%= theme.bg %>" />
                                    <g transform="translate(68, 52)">
                                        <rect x="0" y="6" width="42" height="30" rx="7" fill="<%= theme.bg %>" />
                                        <rect x="0" y="15" width="42" height="2.5" fill="#ffffff" />
                                        <rect x="18" y="13" width="6" height="7" rx="1.5" fill="#ffffff" />
                                    </g>
                                </svg>
                            <% } else if (idx % 4 === 2) { %>
                                <svg width="104" height="104" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="60" cy="45" r="16" fill="<%= theme.bg %>" />
                                    <path d="M30 92C30 74 44 68 60 68C76 68 90 74 90 92H30Z" fill="<%= theme.bg %>" />
                                    <circle cx="60" cy="60" r="48" stroke="<%= theme.bg %>" stroke-width="3" stroke-dasharray="6 6" />
                                </svg>
                            <% } else { %>
                                <svg width="104" height="104" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="30" y="30" width="60" height="60" rx="16" fill="<%= theme.bg %>" />
                                    <circle cx="60" cy="60" r="14" fill="#ffffff" />
                                    <path d="M50 48L70 48" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
                                </svg>
                            <% } %>
                        </div>

                        <div>
                            <div class="students-label" style="color: <%= theme.titleColor %>;"><%= mainPart.toUpperCase() %></div>
                            <div class="students-sublabel" style="color: <%= theme.titleColor %>;"><%= subPart.toUpperCase() %></div>
                            <% if (ev.venue) { %>
                                <div style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-top: 6px;"><%= ev.venue %></div>
                            <% } %>
                        </div>
                    </label>
                    <% }); %>
                </div>

                <!-- Action Buttons: PROCEED / SELECT & CANCEL -->
                <div class="proceed-btn-wrapper">
                    <button type="submit" class="btn-proceed" id="proceedBtn">UPDATE SELECTED EVENT</button>
                    <a href="/scanner.php<%= sidParam %>" class="btn-cancel-return">Keep Current Event</a>
                </div>

            </form>

        </div>

        <!-- Footer -->
        <footer class="devfest-footer">
            <p class="devfest-footer-text">
                &copy; 2026 GDG BACOLOD - AI Innovations Team . All Rights Reserved
            </p>
        </footer>

    </main>

</div>

<script>
// Dynamic Interactive Card Selection and Event Binding
const trackCards = document.querySelectorAll('.track-card');
const selectedEventIdInput = document.getElementById('selectedEventId');

trackCards.forEach(card => {
    card.addEventListener('click', function() {
        trackCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const radio = card.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
        const evId = card.getAttribute('data-event-id');
        if (selectedEventIdInput && evId) {
            selectedEventIdInput.value = evId;
        }
    });
});


// Error handling: Prevent Backspace key from navigating back when logged in
window.addEventListener('keydown', function(event) {
    if (event.key === 'Backspace' || event.keyCode === 8) {
        const target = event.target;
        const isEditable = (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) &&
                           !target.readOnly && !target.disabled;
        if (!isEditable) {
            event.preventDefault();
        }
    }
});

// Error handling: Prevent browser back button to login page when authenticated
if (window.history && window.history.pushState) {
    window.history.pushState(null, '', window.location.href);
    window.addEventListener('popstate', function() {
        window.history.pushState(null, '', window.location.href);
    });
}
</script>
<script src="/JAVASCRIPT/nav.js" defer></script>
</body>
</html>
